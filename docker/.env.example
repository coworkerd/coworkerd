# Copy to .env next to docker-compose.yml and change what you need; every line is optional.

# The image tag (docker load -i coworkerd-<version>-linux-<arch>-image.tar.gz).
COWORKERD_VERSION=0.5.0
# Where the nodes' ingress ports listen on this machine: 127.0.0.1 (this machine only) or 0.0.0.0.
COWORKERD_BIND=127.0.0.1
# node-1's ingress; node-2 and node-3 (--profile cluster) use the next two.
COWORKERD_HTTP_PORT=18080
COWORKERD_HTTP_PORT_2=18081
COWORKERD_HTTP_PORT_3=18082
# The control plane (the API of cowctl: cowctl init --url http://127.0.0.1:18090).
COWORKERD_CONTROL_PORT=18090
# The management token (16 to 4096 printable characters, no spaces). Empty: the first start generates
# one into the secrets volume; `docker compose run --rm tool token` prints it.
COWORKERD_MANAGEMENT_TOKEN=
# The administrator's credential of the API (the same rules). Empty: the first start generates one into the
# secrets volume; `docker compose run --rm tool admin-credential` prints it (cowctl tenant ..., credential ...).
COWORKERD_ADMIN_CREDENTIAL=
# Ordinary workerd processes per node (each node has two quarantine processes besides them).
COWORKERD_PROCESS_COUNT=1
# The directory `docker compose run --rm tool upsert ...` sees as /work.
COWORKERD_PROJECT_DIR=./examples/hello
