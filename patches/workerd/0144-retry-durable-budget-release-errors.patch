From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: maslow <wangfugen@126.com>
Date: Wed, 25 Nov 2026 20:27:48 +0800
Subject: [PATCH] Retry transient errors on the durable budget release socket


diff --git a/src/workerd/threaded/threaded-server.c++ b/src/workerd/threaded/threaded-server.c++
index 4c1dff8a02cfc19ee6180b866878ab3c167d1b06..95f3aeaed3b0654eb7a459e61fb1e3557c330d4d 100644
--- a/src/workerd/threaded/threaded-server.c++
+++ b/src/workerd/threaded/threaded-server.c++
@@ -2846,6 +2846,7 @@ struct ThreadedServer {
     size_t offset = 0;
     for (;;) {
       bool pending;
+      bool retry = false;
       {
         std::lock_guard lock(budgetReleaseMutex);
         while (!budgetReleases.empty()) {
@@ -2855,9 +2856,9 @@ struct ThreadedServer {
           if (written < 0 && errno == EINTR) continue;
           if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) break;
           if (written <= 0) {
-            // EOF tells the node to drop all tickets for this generation.
-            (void)shutdown(parent, SHUT_WR);
-            return;
+            if (written < 0 && (errno == EPIPE || errno == ECONNRESET || errno == ENOTCONN)) return;
+            retry = true;
+            break;
           }
           offset += written;
           if (offset == sizeof(uint64_t)) {
@@ -2867,15 +2868,18 @@ struct ThreadedServer {
         }
         pending = !budgetReleases.empty();
       }
+      // Keep a partially sent ticket at the front until the parent receives it.
+      if (retry) {
+        (void)poll(nullptr, 0, 10);
+        continue;
+      }
       pollfd waits[] = {{managerWake, POLLIN, 0}, {parent, short(pending ? POLLOUT : 0), 0}};
       int result;
       do {
         result = poll(waits, 2, -1);
       } while (result < 0 && errno == EINTR);
-      if (result < 0 || (waits[1].revents & (POLLERR | POLLHUP | POLLNVAL))) {
-        (void)shutdown(parent, SHUT_WR);
-        return;
-      }
+      if (result >= 0 && (waits[1].revents & POLLHUP)) return;
+      if (result < 0 || (waits[1].revents & (POLLERR | POLLNVAL))) (void)poll(nullptr, 0, 10);
       uint64_t count;
       while (read(managerWake, &count, sizeof(count)) > 0) {}
     }
