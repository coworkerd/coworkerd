From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: maslow <wangfugen@126.com>
Date: Fri, 6 Nov 2026 16:45:40 +0800
Subject: [PATCH] Add native Cap'n Proto external Binding transport

Ported from the 0.5.3 series 0001

Reuse the Rust external service RPC connection pool and upstream startEvent
metadata bridge for fetch and custom events. Require capnpConnectHost for
the explicit Capnp transport.

diff --git a/src/workerd/server/server/services/mod.rs b/src/workerd/server/server/services/mod.rs
index a01530a1b951abb7df37ba0f56643eabc5931f20..10d1f156c4a399077a3d5a32594fd132814718e7 100644
--- a/src/workerd/server/server/services/mod.rs
+++ b/src/workerd/server/server/services/mod.rs
@@ -214,12 +214,18 @@ fn fixed_pool(dialer: Dialer, style: Style) -> ClientPool {
 /// A capnp connection to the external server, over an HTTP CONNECT tunnel.
 struct RpcConnection(KjOwn<ffi::RpcClient>);
 
+enum Transport {
+    Http,
+    Capnp,
+}
+
 struct ExternalHttp {
     factory: Rc<Factory>,
     /// The connections of every event, the RPC tunnel's included.
     pool: ClientPool,
     rewriter: HttpRewriter,
-    /// The capnp connection custom events go over, made when the first one needs it and dropped
+    transport: Transport,
+    /// The capnp connection events go over, made when the first one needs it and dropped
     /// when it is lost.
     rpc: RefCell<Option<Rc<RpcConnection>>>,
 }
@@ -259,11 +265,19 @@ impl ExternalHttp {
     }
 }
 
-/// An `external` service speaking HTTP or HTTPS.
+/// An `external` service speaking HTTP, HTTPS, or Cap'n Proto over HTTP CONNECT.
 pub struct ExternalHttpService(Rc<ExternalHttp>);
 
 impl Channel for ExternalHttpService {
     fn start_request(&self, metadata: KjOwn<RequestMetadata>) -> Result<KjOwn<WorkerInterface>> {
+        if let Transport::Capnp = self.0.transport {
+            let service = Rc::clone(&self.0);
+            return Ok(worker::PromisedInterface::new(async move {
+                let connection = service.rpc().await?;
+                Ok(ffi::rpc_client_start_request(&connection.0, metadata))
+            })
+            .into_kj());
+        }
         Ok(ExternalHttpRequest {
             service: Rc::clone(&self.0),
             metadata,
@@ -552,11 +566,12 @@ pub fn make_external_service(
             ));
         }
     };
-    let http = |rewriter: HttpRewriter, dialer: Dialer| -> Rc<dyn Channel> {
+    let http = |rewriter: HttpRewriter, dialer: Dialer, transport: Transport| -> Rc<dyn Channel> {
         Rc::new(ExternalHttpService(Rc::new(ExternalHttp {
             factory: Rc::clone(factory),
             pool: fixed_pool(dialer, rewriter.style()),
             rewriter,
+            transport,
             rpc: RefCell::new(None),
         })))
     };
@@ -566,6 +581,20 @@ pub fn make_external_service(
             Ok(http(
                 rewriter,
                 Dialer::new(&address, 80, None, factory.loopback()),
+                Transport::Http,
+            ))
+        }
+        Ok(external_server::Which::Capnp(options)) => {
+            let rewriter = HttpRewriter::new(options.map_err(capnp_error)?)?;
+            if rewriter.capnp_connect_host().is_none() {
+                return Err(kj::failed!(
+                    "Cap'n Proto external service requires capnpConnectHost"
+                ));
+            }
+            Ok(http(
+                rewriter,
+                Dialer::new(&address, 80, None, factory.loopback()),
+                Transport::Capnp,
             ))
         }
         Ok(external_server::Which::Https(https)) => {
@@ -575,6 +604,7 @@ pub fn make_external_service(
             Ok(http(
                 rewriter,
                 Dialer::new(&address, 443, Some((tls, host)), factory.loopback()),
+                Transport::Http,
             ))
         }
         Ok(external_server::Which::Tcp(tcp)) => {
diff --git a/src/workerd/server/workerd.capnp b/src/workerd/server/workerd.capnp
index 63457f6613c6caee9aa854a963efd69408d3edb7..d458a03f33e25b8a31da1aef0e1c47a08d6a06e1 100644
--- a/src/workerd/server/workerd.capnp
+++ b/src/workerd/server/workerd.capnp
@@ -1004,7 +1004,9 @@ struct ExternalServer {
       certificateHost @6 :Text;
     }
 
-    # TODO(someday): Cap'n Proto RPC
+    capnp @7 :HttpOptions;
+    # Use WorkerdBootstrap and RpcWorkerInterface for every event, including fetch().
+    # Establish the connection with HTTP CONNECT; capnpConnectHost must be specified.
   }
 }
 
