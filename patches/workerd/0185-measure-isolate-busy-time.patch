diff --git a/src/workerd/threaded/isolate-busy-test.c++ b/src/workerd/threaded/isolate-busy-test.c++
new file mode 100644
index 0000000000000000000000000000000000000000..ad481b7a1decfb1c825c471f58ee2a9570fd865e
--- /dev/null
+++ b/src/workerd/threaded/isolate-busy-test.c++
@@ -0,0 +1,102 @@
+// Copyright (c) 2026 Cloudflare, Inc.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+//     https://opensource.org/licenses/Apache-2.0
+
+#include "isolate-busy.h"
+
+#include <kj/test.h>
+
+namespace workerd::threaded {
+namespace {
+
+class TestClock final: public kj::MonotonicClock {
+ public:
+  kj::TimePoint now() const override {
+    return kj::origin<kj::TimePoint>() + time;
+  }
+
+  kj::Duration time = 0 * kj::NANOSECONDS;
+};
+
+KJ_TEST("isolate busy time includes a live hold and rolls off bucket by bucket") {
+  TestClock clock;
+  IsolateBusyWindow window(clock);
+  IsolateBusyWindow other(clock);
+
+  clock.time = 50 * kj::MILLISECONDS;
+  window.acquired();
+  clock.time = 150 * kj::MILLISECONDS;
+  KJ_EXPECT(window.sample().throughNs == 100000000);
+  KJ_EXPECT(window.sample().busyNs == 50000000);
+  window.releasing();
+  clock.time = 200 * kj::MILLISECONDS;
+  KJ_EXPECT(window.sample().busyNs == 100000000);
+  KJ_EXPECT(other.sample().busyNs == 0);
+
+  // The second hold leaves an idle gap even though it ends in the same window.
+  clock.time = 225 * kj::MILLISECONDS;
+  window.acquired();
+  clock.time = 250 * kj::MILLISECONDS;
+  window.releasing();
+  clock.time = 3099 * kj::MILLISECONDS;
+  KJ_EXPECT(window.sample().throughNs == 3000000000);
+  KJ_EXPECT(window.sample().busyNs == 125000000);
+  clock.time = 3100 * kj::MILLISECONDS;
+  KJ_EXPECT(window.sample().busyNs == 75000000);
+  clock.time = 3200 * kj::MILLISECONDS;
+  KJ_EXPECT(window.sample().busyNs == 25000000);
+  clock.time = 3300 * kj::MILLISECONDS;
+  KJ_EXPECT(window.sample().busyNs == 0);
+
+  window.acquired();
+  clock.time = 6400 * kj::MILLISECONDS;
+  KJ_EXPECT(window.sample().permille() == 1000);
+  window.releasing();
+  KJ_EXPECT(window.sample().permille() == 1000);
+  clock.time = 9400 * kj::MILLISECONDS;
+  KJ_EXPECT(window.sample().permille() == 0);
+}
+
+KJ_TEST("a release without a matching isolate hold leaves the reading unchanged") {
+  TestClock clock;
+  IsolateBusyWindow window(clock);
+
+  clock.time = 100 * kj::MILLISECONDS;
+  window.releasing();
+  KJ_EXPECT(window.sample().busyNs == 0);
+
+  clock.time = 150 * kj::MILLISECONDS;
+  window.acquired();
+  clock.time = 200 * kj::MILLISECONDS;
+  window.releasing();
+  clock.time = 300 * kj::MILLISECONDS;
+  window.releasing();
+  KJ_EXPECT(window.sample().busyNs == 50000000);
+}
+
+KJ_TEST("the published permille crosses an inclusive fractional threshold at the exact boundary") {
+  TestClock clock;
+  const auto readingAfter = [&](kj::Duration held) {
+    IsolateBusyWindow window(clock);
+    clock.time = 0 * kj::MILLISECONDS;
+    window.acquired();
+    clock.time = held;
+    window.releasing();
+    clock.time = 3 * kj::SECONDS;
+    return window.sample().permille();
+  };
+
+  constexpr uint64_t threshold = 900;
+  constexpr auto boundary = 2700 * kj::MILLISECONDS;
+  const auto below = readingAfter(boundary - 1 * kj::NANOSECONDS);
+  const auto at = readingAfter(boundary);
+  const auto above = readingAfter(boundary + 1 * kj::NANOSECONDS);
+  KJ_EXPECT(below == 899);
+  KJ_EXPECT(below < threshold);
+  KJ_EXPECT(at == threshold);
+  KJ_EXPECT(at >= threshold);
+  KJ_EXPECT(above >= threshold);
+}
+
+}  // namespace
+}  // namespace workerd::threaded
diff --git a/src/workerd/threaded/isolate-busy.h b/src/workerd/threaded/isolate-busy.h
new file mode 100644
index 0000000000000000000000000000000000000000..4b0233b18b938e470f3c90a156cc3a15dcb5b11b
--- /dev/null
+++ b/src/workerd/threaded/isolate-busy.h
@@ -0,0 +1,91 @@
+// Copyright (c) 2026 Cloudflare, Inc.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+//     https://opensource.org/licenses/Apache-2.0
+
+#pragma once
+
+#include <kj/mutex.h>
+#include <kj/time.h>
+
+namespace workerd::threaded {
+
+// A sliding window of wall time under the isolate lock. Each sample ends at the latest
+// completed bucket boundary. The extra bucket retains work since that boundary.
+class IsolateBusyWindow final {
+ public:
+  static constexpr uint64_t BUCKET_NS = 100 * 1000000;
+  static constexpr uint64_t WINDOW_BUCKETS = 30;
+  static constexpr uint64_t WINDOW_NS = BUCKET_NS * WINDOW_BUCKETS;
+
+  struct Sample {
+    uint64_t throughNs;
+    uint64_t busyNs;
+
+    uint64_t permille() const {
+      return busyNs * 1000 / WINDOW_NS;
+    }
+  };
+
+  explicit IsolateBusyWindow(const kj::MonotonicClock& clock): clock(clock) {}
+
+  // Serialize each clock read with the state it describes. The snapshot thread never
+  // takes the V8 locker. Only the outer V8 lock owner calls acquired() and releasing().
+  void acquired() {
+    auto locked = state.lockExclusive();
+    locked->heldSince = nowNs();
+  }
+
+  void releasing() {
+    auto locked = state.lockExclusive();
+    const auto heldSince = KJ_UNWRAP_OR(locked->heldSince, return);
+    const auto end = nowNs();
+    const auto oldest = firstBucket(end / BUCKET_NS) * BUCKET_NS;
+    auto start = kj::max(heldSince, oldest);
+    while (start < end) {
+      const auto index = start / BUCKET_NS;
+      const auto through = kj::min(end, (index + 1) * BUCKET_NS);
+      auto& bucket = locked->buckets[index % (WINDOW_BUCKETS + 1)];
+      if (bucket.index != index) bucket = {index, 0};
+      bucket.busyNs += through - start;
+      start = through;
+    }
+    locked->heldSince = kj::none;
+  }
+
+  Sample sample() const {
+    auto locked = state.lockShared();
+    const auto end = nowNs() / BUCKET_NS;
+    const auto start = firstBucket(end);
+    Sample sample{end * BUCKET_NS, 0};
+    for (const auto& bucket: locked->buckets) {
+      if (bucket.index >= start && bucket.index < end) sample.busyNs += bucket.busyNs;
+    }
+    KJ_IF_SOME(heldSince, locked->heldSince) {
+      const auto heldFrom = kj::max(heldSince, start * BUCKET_NS);
+      if (heldFrom < sample.throughNs) sample.busyNs += sample.throughNs - heldFrom;
+    }
+    return sample;
+  }
+
+ private:
+  static uint64_t firstBucket(uint64_t end) {
+    return end - kj::min(end, WINDOW_BUCKETS);
+  }
+
+  uint64_t nowNs() const {
+    return (clock.now() - kj::origin<kj::TimePoint>()) / kj::NANOSECONDS;
+  }
+
+  struct Bucket {
+    uint64_t index;
+    uint64_t busyNs;
+  };
+  struct State {
+    Bucket buckets[WINDOW_BUCKETS + 1]{};
+    kj::Maybe<uint64_t> heldSince;
+  };
+  const kj::MonotonicClock& clock;
+  kj::MutexGuarded<State> state;
+};
+
+}  // namespace workerd::threaded
