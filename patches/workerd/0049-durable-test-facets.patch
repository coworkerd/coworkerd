diff --git a/src/workerd/server/factory/coworkerd-durable-test-storage-test.c++ b/src/workerd/server/factory/coworkerd-durable-test-storage-test.c++
index 9a4af681d830bd9d726e96551c38519cf13f6932..6f52b534a4cc26474a86b8d3db1f1d9558b24d47 100644
