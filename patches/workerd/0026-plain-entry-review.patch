                             "configuredWorker": if installed.deployment.is_platform() {
                                 self.registry.loaded(installed).map(|worker| format!("{:p}", Rc::as_ptr(&worker)))
@@ -2470,6 +2475,10 @@ impl Service for RootRequest {
