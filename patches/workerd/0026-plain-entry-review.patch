 IdleWorkerRef registerIdleWorker(std::shared_ptr<IdleReaper> reaper,
     kj::StringPtr name, kj::Function<void()> remove, bool eligible = true,
     IdleWorkerLabels labels = {});
-void idleWorkerRetireWhenIdle(const IdleWorkerRef& worker);
+void idleWorkerRetireWhenIdle(const IdleWorkerRef& worker, kj::Function<bool()> backgroundDone);
 void idleWorkerReady(const IdleWorkerRef& worker);
 void idleWorkerFailed(const IdleWorkerRef& worker);
 void idleWorkerRemoved(const IdleWorkerRef& worker, kj::StringPtr reason);
diff --git a/src/workerd/server/factory/worker-factory.c++ b/src/workerd/server/factory/worker-factory.c++
index 83f2ca2aa5c27e4708b4954ce800d40aa49c718e..a0b9ef566979c3abb16ce37312b2fc9a5fc2a92e 100644
--- a/src/workerd/server/factory/worker-factory.c++
+++ b/src/workerd/server/factory/worker-factory.c++
@@ -2071,7 +2071,10 @@ void worker_idle_ready(const CompiledWorker& worker, ::rust::Box<ChannelFactory>
 }
 
 void worker_retire_when_idle(const CompiledWorker& worker) {
-  idleWorkerRetireWhenIdle(worker.getImpl().idleWorker);
+  auto& impl = worker.getImpl();
+  idleWorkerRetireWhenIdle(impl.idleWorker, [target = &impl]() {
+    return target->waitUntilTasks.isEmpty();
+  });
 }
 
 void worker_unlink(const CompiledWorker& worker) {
