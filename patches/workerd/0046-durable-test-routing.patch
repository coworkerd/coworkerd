@@ -0,0 +1,64 @@
+// Copyright (c) 2026 Cloudflare, Inc.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+//     https://opensource.org/licenses/Apache-2.0
+
+#include "coworkerd-durable-placement.h"
+
+#include <kj/test.h>
+
+namespace workerd::server {
+namespace {
+
+using namespace std::chrono_literals;
+constexpr DurableHomeLoad::Time origin{};
+
+KJ_TEST("durable placement excludes a busy copy before it fills") {
+  DurableHomeLoad hot(4s);
+  hot.begin(origin);
+  DurableCopyCandidate candidates[] = {
+    {1, "version-a", 2, 500, hot.busyFor(origin + 500ms), true},
+    {2, "version-a", 1, 500, 0ms, true},
+    {3, "version-b", 3, 500, 0ms, true},
+  };
+  const DurablePlacementLimits limits{4, 1000, 2s};
+  KJ_EXPECT((chooseDurableCopy(candidates, "version-a", limits) == 1));
+  candidates[0].busyFor = hot.busyFor(origin + 2s);
+  KJ_EXPECT((chooseDurableCopy(candidates, "version-a", limits) == 2));
+  candidates[1].memoryBytes = 1000;
+  KJ_EXPECT(!chooseDurableCopy(candidates, "version-a", limits).has_value());
+  hot.end(origin + 3s);
+  candidates[0].busyFor = hot.busyFor(origin + 8s);
+  KJ_EXPECT((chooseDurableCopy(candidates, "version-a", limits) == 1));
+  candidates[0].residentTrees = 4;
+  KJ_EXPECT(!chooseDurableCopy(candidates, "version-a", limits).has_value());
+  candidates[0].residentTrees = 1;
+  candidates[0].placing = false;
+  KJ_EXPECT(!chooseDurableCopy(candidates, "version-a", limits).has_value());
+}
+
+KJ_TEST("durable home time counts execution across turns and ages out across idle time") {
+  DurableHomeLoad home(4s);
+  home.begin(origin + 1s);
+  home.end(origin + 2s);
+  home.begin(origin + 3s);
+  KJ_EXPECT((home.busyFor(origin + 3500ms) == 1500ms));
+  home.end(origin + 4s);
+  KJ_EXPECT((home.busyFor(origin + 5500ms) == 1500ms));
+  KJ_EXPECT((home.busyFor(origin + 10s) == 0ms));
+  home.begin(origin + 11s);
+  home.end(origin + 100s);
+  KJ_EXPECT((home.busyFor(origin + 100s) == 4s));
+  KJ_EXPECT((home.busyFor(origin + 105s) == 0ms));
+}
+
+KJ_TEST("durable home retains the partial bucket at the start of its rolling window") {
+  DurableHomeLoad home(4s);
+  home.begin(origin + 63ms);
+  home.end(origin + 100ms);
+  home.begin(origin + 4050ms);
+  home.end(origin + 4070ms);
+  KJ_EXPECT((home.busyFor(origin + 4070ms) == 57ms));
+}
+
+}  // namespace
+}  // namespace workerd::server
diff --git a/src/workerd/server/factory/coworkerd-durable-placement.c++ b/src/workerd/server/factory/coworkerd-durable-placement.c++
new file mode 100644
index 0000000000000000000000000000000000000000..5cdf2ce86b1edcd52bf1611a7b2bf05c8d2ca96d
--- /dev/null
+++ b/src/workerd/server/factory/coworkerd-durable-placement.c++
@@ -0,0 +1,77 @@
+// Copyright (c) 2026 Cloudflare, Inc.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+//     https://opensource.org/licenses/Apache-2.0
+
+#include "coworkerd-durable-placement.h"
+
+#include <kj/debug.h>
+
+#include <algorithm>
+
+namespace workerd::server {
+
+DurableHomeLoad::DurableHomeLoad(Duration window): width(window / BUCKETS) {
+  KJ_REQUIRE(width > Duration::zero(), "durable placement busy window is too short");
+}
+
+void DurableHomeLoad::begin(Time now) {
+  KJ_ASSERT(!running && now >= Time{});
+  running = now;
+}
+
+void DurableHomeLoad::end(Time now) {
+  KJ_ASSERT(running.has_value() && now >= *running);
+  auto start = std::max(*running, now - window());
+  while (start < now) {
+    const auto index = start.time_since_epoch() / width;
+    const auto end = std::min(now, Time{} + width * (index + 1));
+    auto& bucket = buckets[index % buckets.size()];
+    if (bucket.index != index) bucket = {index};
+    bucket.busy += end - start;
+    start = end;
+  }
+  running.reset();
+}
+
+DurableHomeLoad::Duration DurableHomeLoad::busyFor(Time now) const {
+  const auto oldest = now - window();
+  Duration busy{};
+  for (const auto& bucket: buckets) {
+    if (bucket.index < 0) continue;
+    const auto start = Time{} + width * bucket.index;
+    const auto end = std::min(now, start + width);
+    if (end <= oldest || end <= start) continue;
+    // At most one historical bucket straddles the cutoff. Its contribution
+    // conservatively assumes that busy time was at the end of the bucket.
+    busy += std::min(bucket.busy, end - std::max(start, oldest));
+  }
+  if (running && *running <= now) busy += now - std::max(*running, oldest);
+  return std::min(busy, window());
+}
+
+DurableHomeLoad::Duration DurableHomeLoad::window() const {
+  return width * BUCKETS;
+}
+
+std::optional<uint64_t> chooseDurableCopy(std::span<const DurableCopyCandidate> candidates,
+    std::string_view definition,
+    DurablePlacementLimits limits) {
+  const DurableCopyCandidate* selected = nullptr;
+  for (const auto& candidate: candidates) {
+    if (!candidate.placing || candidate.definition != definition ||
+        candidate.residentTrees >= limits.treesPerCopy ||
+        candidate.memoryBytes >= limits.placementBytes ||
+        candidate.busyFor >= limits.busyThreshold) {
+      continue;
+    }
+    // Pack quiet, warm copies first to bound isolate and thread growth.
+    if (selected == nullptr || candidate.residentTrees > selected->residentTrees ||
+        (candidate.residentTrees == selected->residentTrees &&
+            candidate.busyFor < selected->busyFor)) {
+      selected = &candidate;
+    }
+  }
+  return selected == nullptr ? std::nullopt : std::optional(selected->home);
+}
+
+}  // namespace workerd::server
diff --git a/src/workerd/server/factory/coworkerd-durable-placement.h b/src/workerd/server/factory/coworkerd-durable-placement.h
new file mode 100644
index 0000000000000000000000000000000000000000..cfa62b2738023c269f0322e7b1e036ef6fbf0b21
--- /dev/null
+++ b/src/workerd/server/factory/coworkerd-durable-placement.h
@@ -0,0 +1,64 @@
+// Copyright (c) 2026 Cloudflare, Inc.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+//     https://opensource.org/licenses/Apache-2.0
+
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string_view>
+
+namespace workerd::server {
+
+// A bounded record of synchronous work on one home. A suspended event does not count as busy.
+// The router reads completed turns together with the current turn, if one is still executing.
+class DurableHomeLoad {
+ public:
+  using Clock = std::chrono::steady_clock;
+  using Time = Clock::time_point;
+  using Duration = Clock::duration;
+
+  explicit DurableHomeLoad(Duration window);
+
+  void begin(Time now);
+  void end(Time now);
+  Duration busyFor(Time now) const;
+  Duration window() const;
+
+ private:
+  static constexpr int64_t BUCKETS = 16;
+  struct Bucket {
+    int64_t index = -1;
+    Duration busy{};
+  };
+
+  const Duration width;
+  std::array<Bucket, BUCKETS + 1> buckets;
+  std::optional<Time> running;
+};
+
+struct DurableCopyCandidate {
+  uint64_t home;
+  std::string_view definition;
+  uint32_t residentTrees;
+  uint64_t memoryBytes;
+  DurableHomeLoad::Duration busyFor;
+  bool placing;
+};
+
+struct DurablePlacementLimits {
+  uint32_t treesPerCopy;
+  uint64_t placementBytes;
+  DurableHomeLoad::Duration busyThreshold;
+};
+
+// An existing tree keeps its placement. Call this only for a fresh or newly woken tree.
+// An empty result requires a separately reserved new home, or an overload refusal.
+std::optional<uint64_t> chooseDurableCopy(std::span<const DurableCopyCandidate> candidates,
+    std::string_view definition,
+    DurablePlacementLimits limits);
+
+}  // namespace workerd::server
