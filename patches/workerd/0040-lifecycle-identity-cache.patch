From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: maslow <wangfugen@126.com>
Date: Tue, 17 Nov 2026 13:45:17 +0800
Subject: [PATCH] Cache immutable lifecycle identity fields between
 publications


diff --git a/src/workerd/server/factory/coworkerd-idle-eviction.c++ b/src/workerd/server/factory/coworkerd-idle-eviction.c++
index 431c10776e466f22597c8db1dbd62b9191e9822a..6f96763b03c62737f67e4e66b3618a8a8790642b 100644
--- a/src/workerd/server/factory/coworkerd-idle-eviction.c++
+++ b/src/workerd/server/factory/coworkerd-idle-eviction.c++
@@ -113,6 +113,9 @@ struct IdleWorker {
   bool retireWhenIdle = false;
   kj::Maybe<kj::Function<bool()>> backgroundDone;
   IdleWorkerLabels labels;
+  // Identity and labels are immutable after registration. Escape them once,
+  // rather than repeating that work for every full lifecycle publication.
+  kj::String lifecycleIdentity;
   double lastEnd = monotonicMs(), loadStart = lastEnd, teardownStart = 0;
   uint64_t loadCpu = cpuNs();
   kj::String reason = kj::str("");
@@ -169,7 +172,7 @@ class IdleReaper {
   kj::Promise<void> task = nullptr, collectTask = nullptr, retirementTask = nullptr;
   uint64_t publishedGc = 0;
   uint64_t publicationCpuNs = 0, publications = 0, drainCpuNs = 0, drainPublications = 0, lastDrainRequest = 0;
-  uint64_t publicationMaxWallNs = 0;
+  uint64_t publicationMaxWallNs = 0, publicationLastWallNs = 0;
 
   void publishDrain() {
     auto& channel = lifecycleChannel();
@@ -225,8 +228,7 @@ class IdleReaper {
           unknownBusy |= !tagged && (worker->active || backgroundActive);
         }
         if (worker->created && !worker->destroyed) entries.add(kj::str(
-            "{\"isolate\":", escapeCpuJsonString(worker->name), ",\"instance\":", worker->id,
-            labelFields(worker->labels), ",\"active\":", worker->active,
+            worker->lifecycleIdentity, ",\"active\":", worker->active,
             ",\"backgroundActive\":", backgroundActive ? "true" : "false", "}"));
         ++it;
       } else {
@@ -247,6 +249,7 @@ class IdleReaper {
         ",\"idleEvictMs\":", threshold, ",\"idleDestroyIntervalMs\":", interval,
         ",\"publicationCpuNs\":", publicationCpuNs, ",\"publications\":", publications,
         ",\"publicationMaxWallNs\":", publicationMaxWallNs,
+        ",\"publicationLastWallNs\":", publicationLastWallNs,
         ",\"drainCpuNs\":", drainCpuNs, ",\"drainPublications\":", drainPublications,
         gcSettings().observes() ? processGcJson() : kj::str(""),
         ",\"residentWorkers\":[", kj::strArray(entries, ","), "],\"drainSnapshotComplete\":true}");
@@ -256,7 +259,8 @@ class IdleReaper {
       emit(kj::str("{\"event\":\"snapshot-too-large\",\"pid\":", coworkerdPid(), ",\"bytes\":", row.size(), "}"));
     }
     ++publications; publicationCpuNs += cpuNs() - start; lastPublish = monotonicMs();
-    publicationMaxWallNs = std::max(publicationMaxWallNs, uint64_t((lastPublish - now) * 1000000));
+    publicationLastWallNs = uint64_t((lastPublish - now) * 1000000);
+    publicationMaxWallNs = std::max(publicationMaxWallNs, publicationLastWallNs);
   }
   bool overflowReported = false;
  private:
@@ -412,6 +416,8 @@ IdleWorkerRef registerIdleWorker(std::shared_ptr<IdleReaper> reaper,
   reaper->workers.push_back(worker);
   worker->eligible = eligible;
   worker->labels = std::move(labels);
+  worker->lifecycleIdentity = kj::str("{\"isolate\":", escapeCpuJsonString(worker->name),
+      ",\"instance\":", worker->id, labelFields(worker->labels));
   return worker;
 }
 void idleWorkerObserveBackground(const IdleWorkerRef& worker, kj::Function<bool()> backgroundDone) {
