+int limitEventFd() {
+  static int fd = [] {
+    auto value = getenv("COWORKERD_EVENT_FD");
+    return value == nullptr ? -1 : int(strtol(value, nullptr, 10));
+  }();
+  return fd;
+}
+void writeLimitRow(kj::StringPtr event,
+    kj::StringPtr identity,
+    uint64_t used,
+    uint32_t cpuMs,
+    uint32_t memoryMiB) {
+  int fd = limitEventFd();
+  if (fd < 0) return;
+  auto row = kj::str("{\"event\":\"", event, "\",", identity, "\"cpuUsedNs\":", used,
+      ",\"cpuLimitMs\":", cpuMs, ",\"memoryLimitMiB\":", memoryMiB, ",\"pid\":", getpid(), "}\n");
+  if (row.size() > 4096) return;
+  ssize_t result;
+  do {
+    result = write(fd, row.begin(), row.size());
+  } while (result < 0 && errno == EINTR);
+}
