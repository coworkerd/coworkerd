+}
+std::string str(Json::Reader value, kj::StringPtr name) {
+  return text(value, name).cStr();
+}
+bool flag(Json::Reader value, kj::StringPtr name) {
+  auto item = field(value, name);
+  return item.isBoolean() && item.getBoolean();
