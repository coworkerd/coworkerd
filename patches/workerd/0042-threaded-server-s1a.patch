+uint64_t nowNs(clockid_t clock = CLOCK_MONOTONIC) {
+  timespec t;
+  KJ_SYSCALL(clock_gettime(clock, &t));
+  return uint64_t(t.tv_sec) * 1000000000 + t.tv_nsec;
+}
