   // Whether a binding of this kind can be created in the startup-snapshot zygote and transferred
   // to the Worker started from the snapshot. A Worker with a binding of any other kind starts
diff --git a/src/workerd/threaded/BUILD.bazel b/src/workerd/threaded/BUILD.bazel
new file mode 100644
index 0000000000000000000000000000000000000000..2cac73c8b6ef474222a22f760dac058fdd3d932a
--- /dev/null
+++ b/src/workerd/threaded/BUILD.bazel
@@ -0,0 +1,59 @@
+load("//:build/kj_test.bzl", "kj_test")
+load("//:build/wd_capnp_library.bzl", "wd_capnp_library")
+load("//:build/wd_cc_binary.bzl", "wd_cc_binary")
+load("//:build/wd_cc_library.bzl", "wd_cc_library")
+
+THREADED_DEPS = [
+    ":protocol_capnp",
+    "//src/workerd/api:memory-cache",
+    "//src/workerd/io",
+    "//src/workerd/io:compatibility-date",
+    "//src/workerd/io:worker-entrypoint",
+    "//src/workerd/jsg",
+    "//src/workerd/server:v8-platform-impl",
+    "//src/workerd/server:workerd-api",
+    "//src/workerd/server/factory:coworkerd-steady",
+    "//src/workerd/util:autogate",
+    "//src/workerd/util:entropy",
+    "@capnp-cpp//src/capnp:capnp-rpc",
+    "@capnp-cpp//src/capnp/compat:http-over-capnp",
+    "@capnp-cpp//src/capnp/compat:json",
+    "@capnp-cpp//src/kj:kj-async",
+    "@capnp-cpp//src/kj/compat:kj-http",
+    "@ssl",
+]
+
+wd_cc_binary(
+    name = "coworkerd-threaded",
+    srcs = [
+        "protocol.h",
+        "threaded-server.c++",
+    ],
+    malloc = "//src/workerd/server:malloc",
+    target_compatible_with = ["@platforms//os:linux"],
+    deps = THREADED_DEPS,
+)
+
+wd_capnp_library(
+    src = "protocol.capnp",
+    deps = [
+        "//src/workerd/io:frankenvalue_capnp",
+        "//src/workerd/io:worker-interface_capnp",
+    ],
+)
+
+# A textual include lets components exercise the actual private ownership and
+# enforcement classes without a copy or a second public implementation.
+wd_cc_library(
+    name = "server-source",
+    testonly = True,
+    textual_hdrs = ["threaded-server.c++", "protocol.h"],
+    deps = THREADED_DEPS,
+)
+
+kj_test(
+    src = "threaded-server-test.c++",
+    malloc = "//src/workerd/server:malloc",
+    target_compatible_with = ["@platforms//os:linux"],
+    deps = [":server-source"],
+)
diff --git a/src/workerd/threaded/protocol.capnp b/src/workerd/threaded/protocol.capnp
new file mode 100644
index 0000000000000000000000000000000000000000..53044781b353534a6fbabb5b07c426300a8ef136
--- /dev/null
+++ b/src/workerd/threaded/protocol.capnp
@@ -0,0 +1,19 @@
+@0xd1a2c8be79534f61;
+using Cxx = import "/capnp/c++.capnp";
+$Cxx.namespace("workerd::threaded::rpc");
+using Worker = import "/workerd/io/worker-interface.capnp";
+
+# The native loopback's resolved channels. The node copies the enclosing props
+# without decoding JavaScript values or taking ownership of their implementation.
+struct Channel {
+  union {
