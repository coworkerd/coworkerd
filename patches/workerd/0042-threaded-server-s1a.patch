+class NodeBindingDispatcher final: public rpc::EventDispatcher::Server {
+ public:
+  NodeBindingDispatcher(
+      rpc::WorkerdBootstrap::Client bootstrap, kj::String envelope, PropsMessage props)
+      : bootstrap(kj::mv(bootstrap)),
