+void waitForOrdinaryCallRelease(ThreadedServer& server) {
+  auto until = nowNs() + 3'000'000'000;
+  while (server.ordinaryAdmissionSample().calls != 0 && nowNs() < until) usleep(1000);
+  KJ_ASSERT(server.ordinaryAdmissionSample().calls == 0);
+}
