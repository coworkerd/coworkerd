diff --git a/src/workerd/server/factory/coworkerd-sandbox-test.c++ b/src/workerd/server/factory/coworkerd-sandbox-test.c++
new file mode 100644
index 0000000000000000000000000000000000000000..33b72512aed203b71c64f3db73714cc773e9aa55
--- /dev/null
+++ b/src/workerd/server/factory/coworkerd-sandbox-test.c++
@@ -0,0 +1,171 @@
+// The V8 sandbox in Coworkerd's build (--config=coworkerd-sandbox): its layout, V8's secure mode
+// for the process and for every isolate group, and the two places where the embedder must place
+// bytes in the right group's sandbox.
+#include "coworkerd-memory-limit.h"
+#include "coworkerd-sandbox.h"
+
+#include <workerd/jsg/sandbox.h>
+#include <workerd/jsg/setup.h>
+#include <workerd/server/v8-platform-impl.h>
+
+#include <kj/test.h>
+#include <kj/vector.h>
+#include <v8-array-buffer.h>
+#include <v8-initialization.h>
+#include <v8-internal.h>
+#include <v8-isolate.h>
+#include <v8-locker.h>
+
+#include <cstring>
+
+namespace workerd::server {
+namespace {
+
+// As the workerd binary does: the platform reserves the zero segment before V8 starts.
+kj::Own<v8::Platform> innerPlatform = jsg::defaultPlatform(0);
+WorkerdPlatform platform(*innerPlatform);
+jsg::V8System v8System(platform, nullptr, innerPlatform.get());
+
+#ifdef V8_ENABLE_SANDBOX
+constexpr size_t GiB = size_t(1) << 30;
+
+bool mentions(const kj::Maybe<kj::String>& problem, const char* words) {
+  KJ_IF_SOME(text, problem) {
+    return strstr(text.cStr(), words) != nullptr;
+  }
+  return false;
+}
+
+// An isolate in `group`, with `allocator` or else V8's allocator for that group.
+struct GroupIsolate {
+  explicit GroupIsolate(
+      v8::IsolateGroup groupParam, std::shared_ptr<v8::ArrayBuffer::Allocator> allocator = nullptr)
+      : group(kj::mv(groupParam)) {
+    v8::Isolate::CreateParams params;
+    params.array_buffer_allocator_shared = allocator != nullptr
+        ? kj::mv(allocator)
+        : std::shared_ptr<v8::ArrayBuffer::Allocator>(
+              v8::ArrayBuffer::Allocator::NewDefaultAllocator(group));
+    isolate = v8::Isolate::New(group, params);
+  }
+  ~GroupIsolate() {
+    isolate->Dispose();
+  }
+  KJ_DISALLOW_COPY_AND_MOVE(GroupIsolate);
+
+  v8::IsolateGroup group;
+  v8::Isolate* isolate;
+};
+
+// First: V8 answers for the calling thread's sandbox, which is the process-wide one only until
+// this thread has entered and left an isolate.
+KJ_TEST("the process-wide sandbox is secure and laid out as configured") {
+  KJ_EXPECT(v8::internal::kSandboxSize == 8 * GiB);
+  KJ_EXPECT(v8::internal::kSandboxGuardRegionSize == 64 * GiB);
+  KJ_EXPECT(v8::internal::kAdditionalTrailingGuardRegionSize == 0);
+  KJ_EXPECT(v8::internal::kRequiresTypedArrayAccessMasks);
+  KJ_EXPECT(v8::IsolateGroup::CanCreateNewGroups());
+
+  KJ_EXPECT(v8::V8::GetSandboxMode() == v8::V8::SandboxMode::kSecure,
+      sandboxModeName(static_cast<int>(v8::V8::GetSandboxMode())));
+  KJ_EXPECT(v8::V8::GetSandboxSizeInBytes() == 8 * GiB);
+  KJ_EXPECT(v8::V8::GetSandboxAddressSpace()->size() == 136 * GiB);
+  SandboxFacts facts{
+    .mode = static_cast<int>(v8::V8::GetSandboxMode()),
+    .sandboxBytes = v8::V8::GetSandboxSizeInBytes(),
+    .addressSpaceBytes = v8::V8::GetSandboxAddressSpace()->size(),
+    .groupPerIsolate = v8::IsolateGroup::CanCreateNewGroups(),
+  };
+  KJ_EXPECT(sandboxProblem(facts) == kj::none);
+}
+
+KJ_TEST("every isolate group has its own secure sandbox") {
+  constexpr size_t COUNT = 3;
+  kj::Vector<kj::Own<GroupIsolate>> isolates;
+  kj::Vector<uintptr_t> bases;
+  bases.add(v8::IsolateGroup::GetDefault().GetSandboxAddressSpace()->base());
+  for (size_t i = 0; i < COUNT; i++) {
+    auto& entry = *isolates.add(kj::heap<GroupIsolate>(jsg::newIsolateGroup()));
+    v8::Locker locker(entry.isolate);
+    v8::Isolate::Scope scope(entry.isolate);
+    auto* space = entry.group.GetSandboxAddressSpace();
+    KJ_EXPECT(v8::V8::GetSandboxAddressSpace() == space);
+    KJ_EXPECT(v8::V8::GetSandboxMode() == v8::V8::SandboxMode::kSecure,
+        sandboxModeName(static_cast<int>(v8::V8::GetSandboxMode())));
+    KJ_EXPECT(space->size() == 136 * GiB);
+    requireSecureIsolateSandbox(entry.isolate, "every-group-test"_kj);
+    bases.add(space->base());
+  }
+  // The default group's and the three new ones: four reservations that do not overlap.
+  for (size_t i = 0; i < bases.size(); i++) {
+    for (size_t j = i + 1; j < bases.size(); j++) {
+      KJ_EXPECT(bases[i] + 136 * GiB <= bases[j] || bases[j] + 136 * GiB <= bases[i], i, j);
+    }
+  }
+}
+
+KJ_TEST("a memory-limited isolate allocates its ArrayBuffers in its own sandbox") {
+  auto group = jsg::newIsolateGroup();
+  auto other = jsg::newIsolateGroup();
+  auto state = std::make_shared<std::atomic<IsolateLimitCause>>(IsolateLimitCause::NONE);
+  auto limit = std::make_shared<IsolateMemoryLimit>(64, state, group);
+  GroupIsolate entry(group, limit);
+  v8::Locker locker(entry.isolate);
+  v8::Isolate::Scope scope(entry.isolate);
+  // A backing store through the isolate's allocator; V8 checks that it lies in the isolate's sandbox.
+  auto store = v8::ArrayBuffer::NewBackingStore(entry.isolate, 1 << 20);
+  KJ_EXPECT(group.SandboxContains(store->Data()));
+  KJ_EXPECT(!other.SandboxContains(store->Data()));
+  KJ_EXPECT(limit->bufferBytes.load() >= size_t(1) << 20);
+}
+
+KJ_TEST("a byte view of an ArrayBuffer decodes to the same bytes in its isolate's sandbox") {
+  GroupIsolate entry(jsg::newIsolateGroup());
+  v8::Locker locker(entry.isolate);
+  v8::Isolate::Scope scope(entry.isolate);
+  auto store = v8::ArrayBuffer::NewBackingStore(entry.isolate, 4096);
+  auto bytes = kj::arrayPtr(static_cast<const kj::byte*>(store->Data()), 4096);
+  jsg::SandboxedBytes view(entry.isolate, bytes);
+  auto decoded = view.get(entry.isolate);
+  KJ_EXPECT(decoded.begin() == bytes.begin());
+  KJ_EXPECT(decoded.size() == bytes.size());
+}
+
+KJ_TEST("sandboxProblem names what is wrong with a sandbox") {
+  SandboxFacts good{
+    .mode = static_cast<int>(v8::V8::SandboxMode::kSecure),
+    .sandboxBytes = 8 * GiB,
+    .addressSpaceBytes = 136 * GiB,
+    .groupPerIsolate = true,
+  };
+  KJ_EXPECT(sandboxProblem(good) == kj::none);
+
+  auto smiAccessible = good;
+  smiAccessible.mode = static_cast<int>(v8::V8::SandboxMode::kInsecureFullReservationSmiAccessible);
+  KJ_EXPECT(mentions(sandboxProblem(smiAccessible), "first 4 GiB"));
+
+  auto partial = good;
+  partial.mode = static_cast<int>(v8::V8::SandboxMode::kInsecurePartialReservationSmiInaccessible);
+  KJ_EXPECT(mentions(sandboxProblem(partial), "guard regions"));
+
+  auto sharedCage = good;
+  sharedCage.groupPerIsolate = false;
+  KJ_EXPECT(mentions(sandboxProblem(sharedCage), "one pointer-compression cage"));
+
+  auto defaultSize = good;
+  defaultSize.sandboxBytes = 1024 * GiB;
+  KJ_EXPECT(mentions(sandboxProblem(defaultSize), "sandbox defines"));
+
+  auto defaultTrailingGuard = good;
+  defaultTrailingGuard.addressSpaceBytes = 360 * GiB;
+  KJ_EXPECT(mentions(sandboxProblem(defaultTrailingGuard), "reserves"));
+}
+#else
+KJ_TEST("without the sandbox nothing is checked") {
+  KJ_EXPECT(sandboxModeName(0) == "off"_kj);
+  KJ_EXPECT(sandboxProblem(SandboxFacts{}) == kj::none);
+}
+#endif
+
+}  // namespace
+}  // namespace workerd::server
diff --git a/src/workerd/server/factory/coworkerd-sandbox.c++ b/src/workerd/server/factory/coworkerd-sandbox.c++
new file mode 100644
index 0000000000000000000000000000000000000000..36915b5f4dfd859612e81e96a26c80a13ee563d4
--- /dev/null
+++ b/src/workerd/server/factory/coworkerd-sandbox.c++
@@ -0,0 +1,155 @@
+#include "coworkerd-sandbox.h"
+
+#include "coworkerd-cpu-limit.h"
+
+#include <kj/debug.h>
+#include <v8-initialization.h>
+#include <v8-internal.h>
+#include <v8-isolate.h>
+#include <v8-platform.h>
+
+#include <cerrno>
+#include <unistd.h>
+
+namespace workerd::server {
+
+namespace {
+
+#ifdef V8_ENABLE_SANDBOX
+void writeStderr(kj::StringPtr line) {
+  size_t done = 0;
+  while (done < line.size()) {
+    ssize_t written = write(STDERR_FILENO, line.begin() + done, line.size() - done);
+    if (written < 0 && errno == EINTR) continue;
+    if (written <= 0) return;
+    done += written;
+  }
+}
+
+using v8::internal::kAdditionalTrailingGuardRegionSize;
+using v8::internal::kRequiresTypedArrayAccessMasks;
+using v8::internal::kSandboxGuardRegionSize;
+using v8::internal::kSandboxSize;
+
+// The address space V8 reserves for one sandbox in this build: the front guard region, the
+// sandbox, the back guard region and any additional trailing guard region (sandbox.cc).
+constexpr size_t CONFIGURED_ADDRESS_SPACE =
+    kSandboxSize + 2 * kSandboxGuardRegionSize + kAdditionalTrailingGuardRegionSize;
+
+// The sandbox of the calling thread: the process-wide one on the thread that initialized V8, an
+// isolate's own while that isolate is entered.
+SandboxFacts currentFacts() {
+  return {
+    .mode = static_cast<int>(v8::V8::GetSandboxMode()),
+    .sandboxBytes = v8::V8::GetSandboxSizeInBytes(),
+    .addressSpaceBytes = v8::V8::GetSandboxAddressSpace()->size(),
+    .groupPerIsolate = v8::IsolateGroup::CanCreateNewGroups(),
+  };
+}
+
+// One [coworkerd-sandbox] row: `subject` names what was checked (a JSON member), then V8's facts,
+// this build's layout and the problem, if any.
+void writeRow(kj::StringPtr subject, const SandboxFacts& facts, kj::Maybe<kj::StringPtr> problem) {
+  auto problemMember = problem.map([](kj::StringPtr text) {
+    return kj::str(",\"problem\":", escapeCpuJsonString(text));
+  }).orDefault(kj::String());
+  writeStderr(kj::str("[coworkerd-sandbox] {", subject, ",\"mode\":\"", sandboxModeName(facts.mode),
+      "\",\"sandboxBytes\":", facts.sandboxBytes, ",\"reservationBytes\":", facts.addressSpaceBytes,
+      ",\"guardBytes\":", kSandboxGuardRegionSize,
+      ",\"trailingGuardBytes\":", kSandboxGuardRegionSize + kAdditionalTrailingGuardRegionSize,
+      ",\"typedArrayAccessMasks\":", kRequiresTypedArrayAccessMasks ? "true" : "false",
+      ",\"groupPerIsolate\":", facts.groupPerIsolate ? "true" : "false", problemMember, "}\n"));
+}
+#endif
+
+}  // namespace
+
+kj::StringPtr sandboxModeName(int mode) {
+#ifdef V8_ENABLE_SANDBOX
+  switch (static_cast<v8::V8::SandboxMode>(mode)) {
+    case v8::V8::SandboxMode::kSecure:
+      return "secure"_kj;
+    case v8::V8::SandboxMode::kInsecureFullReservationSmiAccessible:
+      return "smi-accessible"_kj;
+    case v8::V8::SandboxMode::kInsecurePartialReservationSmiInaccessible:
+      return "partially-reserved"_kj;
+    case v8::V8::SandboxMode::kInsecurePartialReservationSmiAccessible:
+      return "partially-reserved-smi-accessible"_kj;
+    default:
+      return "insecure"_kj;
+  }
+#else
+  (void)mode;
+  return "off"_kj;
+#endif
+}
+
+kj::Maybe<kj::String> sandboxProblem(const SandboxFacts& facts) {
+#ifdef V8_ENABLE_SANDBOX
+  if (!facts.groupPerIsolate) {
+    return kj::str("this build has one pointer-compression cage, and with it one sandbox, for every "
+                   "isolate; build with --config=coworkerd-sandbox");
+  }
+  if (facts.sandboxBytes != kSandboxSize) {
+    return kj::str("V8's sandbox is ", facts.sandboxBytes, " bytes, not the ", kSandboxSize,
+        " this build was configured with: part of the build lacks the sandbox defines");
+  }
+  switch (static_cast<v8::V8::SandboxMode>(facts.mode)) {
+    case v8::V8::SandboxMode::kSecure:
+      break;
+    case v8::V8::SandboxMode::kInsecureFullReservationSmiAccessible:
+      return kj::str("the first 4 GiB of the address space are not reserved (something is mapped "
+                     "there, or vm.mmap_min_addr is above 64 KiB), so V8's sandbox is not secure "
+                     "(smi-accessible)");
+    case v8::V8::SandboxMode::kInsecurePartialReservationSmiInaccessible:
+    case v8::V8::SandboxMode::kInsecurePartialReservationSmiAccessible:
+      return kj::str("V8 could not reserve its sandbox with guard regions, so the sandbox is not "
+                     "secure (",
+          sandboxModeName(facts.mode), ")");
+    default:
+      return kj::str("V8 reports its sandbox as insecure (mode ", facts.mode, ")");
+  }
+  if (facts.addressSpaceBytes != CONFIGURED_ADDRESS_SPACE) {
+    return kj::str("V8's sandbox reserves ", facts.addressSpaceBytes,
+        " bytes with its guard regions, not the ", CONFIGURED_ADDRESS_SPACE,
+        " this build was configured with: part of the build lacks the sandbox defines");
+  }
+#else
+  (void)facts;
+#endif
+  return kj::none;
+}
+
+void requireSecureSandbox() {
+#ifdef V8_ENABLE_SANDBOX
+  auto facts = currentFacts();
+  auto problem = sandboxProblem(facts);
+  writeRow("\"process\":true"_kj, facts, problem.map([](kj::String& text) -> kj::StringPtr {
+    return text;
+  }));
+  KJ_IF_SOME(text, problem) {
+    writeStderr(kj::str("workerd: refusing to start: ", text, "\n"));
+    _exit(SANDBOX_REFUSED_EXIT);
+  }
+#endif
+}
+
+void requireSecureIsolateSandbox(v8::Isolate* isolate, kj::StringPtr name) {
+#ifdef V8_ENABLE_SANDBOX
+  // V8 answers for the calling thread's sandbox; it must be this isolate's.
+  KJ_REQUIRE(isolate->GetGroup().GetSandboxAddressSpace() == v8::V8::GetSandboxAddressSpace(),
+      "the isolate's sandbox is not the current one; is the isolate entered?", name);
+  auto facts = currentFacts();
+  auto problem = sandboxProblem(facts);
+  writeRow(kj::str("\"isolate\":", escapeCpuJsonString(name)), facts,
+      problem.map([](kj::String& text) -> kj::StringPtr { return text; }));
+  KJ_IF_SOME(text, problem) {
+    KJ_FAIL_REQUIRE("the V8 sandbox of this isolate is not usable", name, text);
+  }
+#else
+  (void)isolate;
+  (void)name;
+#endif
+}
+
+}  // namespace workerd::server
diff --git a/src/workerd/server/factory/coworkerd-sandbox.h b/src/workerd/server/factory/coworkerd-sandbox.h
new file mode 100644
index 0000000000000000000000000000000000000000..02b1469d4543343cfe8e67666121dd5a10d0739f
--- /dev/null
+++ b/src/workerd/server/factory/coworkerd-sandbox.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <kj/common.h>
+#include <kj/string.h>
+#include <cstddef>
+
+namespace v8 {
+class Isolate;
+}
+
+namespace workerd::server {
+
+// The V8 sandbox as Coworkerd builds it (--config=coworkerd-sandbox in .bazelrc): one 8 GiB
+// sandbox per isolate group, with V8's guard regions. V8 classifies a sandbox as secure when its
+// address space is fully reserved and the first 4 GiB of the process's address space and a page
+// can never be mapped (WorkerdPlatform reserves them before V8 starts). Without V8_ENABLE_SANDBOX
+// nothing here checks or writes anything.
+
+// What V8 reports for one sandbox.
+struct SandboxFacts {
+  int mode = 0;                  // v8::V8::SandboxMode
+  size_t sandboxBytes = 0;       // v8::V8::GetSandboxSizeInBytes()
+  size_t addressSpaceBytes = 0;  // the sandbox's address space, its guard regions included
+  bool groupPerIsolate = false;  // v8::IsolateGroup::CanCreateNewGroups()
+};
+
+// Why `facts` do not describe a secure sandbox laid out as this build configured it, or none.
+kj::Maybe<kj::String> sandboxProblem(const SandboxFacts& facts);
+
+// V8's name-like spelling of a v8::V8::SandboxMode: "secure", "smi-accessible",
+// "partially-reserved", "partially-reserved-smi-accessible", or "insecure"; "off" without the
+// sandbox.
+kj::StringPtr sandboxModeName(int mode);
+
+// Checks the process-wide sandbox once V8 is initialized, on the thread that initialized it, and
+// writes one [coworkerd-sandbox] row to stderr. Unless the sandbox is secure and laid out as this
+// build configured it, the row carries the problem and the process exits with status
+// SANDBOX_REFUSED_EXIT before it loads any Worker.
+void requireSecureSandbox();
+constexpr int SANDBOX_REFUSED_EXIT = 78;
+
+// The same for the sandbox of `isolate`, which the caller holds locked and entered, before the
+// isolate runs any code; the row names the isolate. Throws instead of exiting, so that only this
+// Worker is not created.
+void requireSecureIsolateSandbox(v8::Isolate* isolate, kj::StringPtr name);
+
+}  // namespace workerd::server
