+++ b/src/workerd/jsg/sandbox.c++
@@ -4,6 +4,7 @@
 
 #include "sandbox.h"
 
+#include <v8-array-buffer.h>
 #include <v8-internal.h>
 #include <v8-isolate.h>
 #include <v8-platform.h>
@@ -21,14 +22,67 @@ constexpr uint64_t CAGE_SIZE = uint64_t{1} << 32;
