+void SqliteDatabase::clearRolledBackTransaction() {
+  savepoints.clear();
+  inTransaction = false;
+  while (!rollbackCallbacks.empty()) {
+    rollbackCallbacks.back()();
+    rollbackCallbacks.removeLast();
+  }
+}
