new file mode 100644
index 0000000000000000000000000000000000000000..44e832b18d53934706ca234df0f0446894dcc0cf
--- /dev/null
+++ b/src/workerd/jsg/coworkerd-rpc-code.c++
@@ -0,0 +1,14 @@
+#include "coworkerd-rpc-code.h"
+#include "jsg.h"
+
+namespace workerd::jsg {
+void coworkerdSetRpcErrorCode(v8::Isolate* isolate, v8::Local<v8::Value> value,
+    const kj::Exception& exception) {
+  if (!value->IsObject()) return;
+  KJ_IF_SOME(code, exception.getDetail(COWORKERD_CODE_DETAIL_ID)) {
+    auto text = kj::heapString(code.asChars());
+    check(value.As<v8::Object>()->Set(isolate->GetCurrentContext(),
+        v8StrIntern(isolate, "code"_kj), v8Str(isolate, text)));
+  }
+}
+}  // namespace workerd::jsg
diff --git a/src/workerd/jsg/coworkerd-rpc-code.h b/src/workerd/jsg/coworkerd-rpc-code.h
new file mode 100644
index 0000000000000000000000000000000000000000..b82413c9bae32a96f505bdda2a7c5dec1cfb3d02
--- /dev/null
+++ b/src/workerd/jsg/coworkerd-rpc-code.h
@@ -0,0 +1,15 @@
+#pragma once
+
+#include <kj/exception.h>
+#include <kj/string.h>
+
+namespace workerd::jsg {
+// Assigned by the v76 RPC error-detail contract. Keep in sync with the node's
+// common/rpc-error.h. The value is a platform code's bytes, without a trailing NUL.
+inline constexpr kj::Exception::DetailTypeId COWORKERD_CODE_DETAIL_ID = 0xc6f4a09d8b3e2175ull;
+
+inline kj::Exception tagCoworkerdRpcError(kj::Exception error, kj::StringPtr code) {
+  error.setDetail(COWORKERD_CODE_DETAIL_ID, kj::heapArray(code.asBytes()));
+  return error;
+}
+}  // namespace workerd::jsg
