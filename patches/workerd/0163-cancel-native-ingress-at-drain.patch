From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: maslow <wangfugen@126.com>
Date: Wed, 25 Nov 2026 16:56:51 +0800
Subject: [PATCH] Cancel native foreground HTTP when ingress ends


diff --git a/src/workerd/threaded/protocol.capnp b/src/workerd/threaded/protocol.capnp
index ae7401dcf67f81a6b9ad2f9ec23e83f8d4589c2a..647420cc828c1154ca4a1a085fc57f01c39b63ee 100644
--- a/src/workerd/threaded/protocol.capnp
+++ b/src/workerd/threaded/protocol.capnp
@@ -98,11 +98,12 @@ interface ThreadedSocketControl @0xdc432f018090bcc4 {
 
 interface Bootstrap @0xa0c731b2df279451 extends(Worker.WorkerdBootstrap) {
   startNativeEvent @0 (cfBlobJson :Text, coworkerdProps :Props, budgetLifetime :Capability,
-                       lease :NativeLeaseControl)
+                       lease :NativeLeaseControl, cancelOnIngressEnd :Bool)
       -> (dispatcher :Worker.EventDispatcher);
   socketControl @1 () -> (control :ThreadedSocketControl);
 }
 
 interface NativeLeaseControl @0xbbb54ed58665162a $Cxx.allowCancellation {
   whenEnded @0 () -> ();
+  whenIngressEnded @1 () -> ();
 }
diff --git a/src/workerd/threaded/threaded-server.c++ b/src/workerd/threaded/threaded-server.c++
index 46e750c57dd969128b34ce501879a1006229ddc2..278608b8823792be51b9006f123e8adaf4d40599 100644
--- a/src/workerd/threaded/threaded-server.c++
+++ b/src/workerd/threaded/threaded-server.c++
@@ -2264,13 +2264,14 @@ class Invocation final: public kj::HttpService {
  public:
   Invocation(ThreadedServer &server, ThreadState &state, kj::String descriptor, Frankenvalue props,
       capnp::Capability::Client budgetLifetime,
-      kj::Maybe<threaded::rpc::NativeLeaseControl::Client> lease)
+      kj::Maybe<threaded::rpc::NativeLeaseControl::Client> lease, bool cancelOnIngressEnd)
       : server(server),
         state(state),
         descriptor(kj::mv(descriptor)),
         props(kj::mv(props)),
         budgetLifetime(kj::mv(budgetLifetime)),
-        lease(kj::mv(lease)) {}
+        lease(kj::mv(lease)),
+        cancelOnIngressEnd(cancelOnIngressEnd) {}
   kj::Promise<void> request(kj::HttpMethod method,
       kj::StringPtr url,
       const kj::HttpHeaders &headers,
@@ -2284,6 +2285,7 @@ class Invocation final: public kj::HttpService {
   Frankenvalue props;
   capnp::Capability::Client budgetLifetime;
   kj::Maybe<threaded::rpc::NativeLeaseControl::Client> lease;
+  bool cancelOnIngressEnd;
   bool used = false;
 };
 
@@ -2291,18 +2293,20 @@ class Dispatcher final: public rpc::EventDispatcher::Server {
  public:
   Dispatcher(ThreadedServer &server, ThreadState &state, kj::String descriptor, Frankenvalue props,
       capnp::Capability::Client budgetLifetime,
-      kj::Maybe<threaded::rpc::NativeLeaseControl::Client> lease = kj::none)
+      kj::Maybe<threaded::rpc::NativeLeaseControl::Client> lease = kj::none, bool cancelOnIngressEnd = false)
       : server(server),
         state(state),
         descriptor(kj::mv(descriptor)),
         props(kj::mv(props)),
         budgetLifetime(kj::mv(budgetLifetime)),
-        lease(kj::mv(lease)) {}
+        lease(kj::mv(lease)),
+        cancelOnIngressEnd(cancelOnIngressEnd) {}
   kj::Promise<void> getHttpService(GetHttpServiceContext context) override {
     KJ_REQUIRE(!used, "NOT_SUPPORTED: one HTTP event per invocation");
     used = true;
     context.initResults().setHttp(state.http.kjToCapnp(
-        kj::heap<Invocation>(server, state, kj::mv(descriptor), kj::mv(props), kj::mv(budgetLifetime), kj::mv(lease))));
+        kj::heap<Invocation>(server, state, kj::mv(descriptor), kj::mv(props), kj::mv(budgetLifetime),
+            kj::mv(lease), cancelOnIngressEnd)));
     return kj::READY_NOW;
   }
   kj::Promise<void> jsRpcSession(JsRpcSessionContext context) override;
@@ -2314,6 +2318,7 @@ class Dispatcher final: public rpc::EventDispatcher::Server {
   Frankenvalue props;
   capnp::Capability::Client budgetLifetime;
   kj::Maybe<threaded::rpc::NativeLeaseControl::Client> lease;
+  bool cancelOnIngressEnd;
   bool used = false;
 };
 
@@ -2339,7 +2344,7 @@ class Bootstrap final: public threaded::rpc::Bootstrap::Server {
     if (params.hasLease()) lease = params.getLease();
     context.getResults().setDispatcher(kj::heap<Dispatcher>(server, state,
         kj::str(params.getCfBlobJson()), readNativeProps(state, params.getCoworkerdProps()),
-        params.getBudgetLifetime(), kj::mv(lease)));
+        params.getBudgetLifetime(), kj::mv(lease), params.getCancelOnIngressEnd()));
     return kj::READY_NOW;
   }
 
@@ -7007,6 +7012,13 @@ kj::Promise<void> Invocation::request(kj::HttpMethod method,
       httpEntryObserver(input, entrypoint.c_str(), headers, state.placementCallId));
   auto &invocation = prepared.invocation;
   auto &entry = prepared.entry;
+  // The open transport may outlive an ingress response to carry its waitUntil work.
+  // End only the foreground HTTP promise at the ingress boundary.
+  kj::Maybe<kj::Promise<void>> ingressEnded;
+  if (cancelOnIngressEnd) {
+    auto &control = KJ_REQUIRE_NONNULL(lease);
+    ingressEnded = control.whenIngressEndedRequest().send().ignoreResult().catch_([](kj::Exception &&) {});
+  }
   watchRequestLease(invocation->measurement, kj::mv(lease));
   kj::Maybe<kj::Exception> failure;
   LimitedResponse checkedResponse(response, *invocation);
@@ -7017,7 +7029,11 @@ kj::Promise<void> Invocation::request(kj::HttpMethod method,
   invocation->measurement.responseEnded = responseEnd.promise.fork();
   KJ_DEFER(if (responseEnd.fulfiller->isWaiting()) responseEnd.fulfiller->fulfill());
   try {
-    co_await entry->request(method, url, headers, body, checkedResponse);
+    auto responseTask = entry->request(method, url, headers, body, checkedResponse);
+    KJ_IF_SOME(ended, ingressEnded) {
+      responseTask = kj::mv(responseTask).exclusiveJoin(kj::mv(ended));
+    }
+    co_await responseTask;
   } catch (const kj::Exception &error) {
     failure = error.clone();
   }
