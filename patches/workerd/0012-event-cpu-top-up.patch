From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Thu, 5 Nov 2026 22:12:12 +0800
Subject: [PATCH] Top up every request's CPU for each new event and report it
 while it lasts

Ported from the 0.5.3 series 0012

diff --git a/src/workerd/server/factory/coworkerd-cpu-limit.c++ b/src/workerd/server/factory/coworkerd-cpu-limit.c++
index 3981f4065eb9306bed41473aef277fa81ae976f0..e4881cb11011a143d78ae4c9e74de09ea511ba47 100644
--- a/src/workerd/server/factory/coworkerd-cpu-limit.c++
+++ b/src/workerd/server/factory/coworkerd-cpu-limit.c++
@@ -255,11 +255,20 @@ class RequestLimits final: public LimitEnforcer {
         kj::String identity, kj::Function<void()> abortIsolate)
         : fallback(kj::mv(fallback)), limits(kj::addRef(limits)),
           abortIsolate(kj::mv(abortIsolate)), identity(kj::mv(identity)) {}
-    ~RequestLimits() noexcept(false) { limits->completed(identity, cpuUsed); }
+    ~RequestLimits() noexcept(false) { limits->completed(identity, toppedUp + cpuUsed); }
     kj::Own<void> enterJs(jsg::Lock&, IoContext&) override {
       return limits->enterRequestJs(cpuUsed, identity, [this]() { if (limits->publish()) abortIsolate(); });
     }
-    void topUpActor() override {}
+    void topUpActor() override {
+      toppedUp += cpuUsed;
+      cpuUsed = 0;
+      auto now = LimitWatchdog::now();
+      if (toppedUp > reported && now - lastProgress >= 1 * kj::SECONDS) {
+        lastProgress = now;
+        reported = toppedUp;
+        limits->progress(identity, toppedUp);
+      }
+    }
     void newSubrequest(bool inHouse) override { fallback->newSubrequest(inHouse); }
     void newKvRequest(KvOpType type) override { fallback->newKvRequest(type); }
     void newAnalyticsEngineRequest() override { fallback->newAnalyticsEngineRequest(); }
@@ -280,7 +289,8 @@ class RequestLimits final: public LimitEnforcer {
     kj::Own<CpuIsolateLimitEnforcer> limits;
     kj::Function<void()> abortIsolate;
     kj::String identity;
-    uint64_t cpuUsed = 0;
+    uint64_t cpuUsed = 0, toppedUp = 0, reported = 0;
+    kj::TimePoint lastProgress = kj::origin<kj::TimePoint>();
   };
 
 
diff --git a/src/workerd/server/factory/coworkerd-cpu-limit.h b/src/workerd/server/factory/coworkerd-cpu-limit.h
index 51fb2beb61bb07f5c191430fb3300f57a981cc19..831b2c19c43adaa6de9807af0a8173cde9b4b321 100644
--- a/src/workerd/server/factory/coworkerd-cpu-limit.h
+++ b/src/workerd/server/factory/coworkerd-cpu-limit.h
@@ -162,6 +162,9 @@ class CpuIsolateLimitEnforcer final: public IsolateLimitEnforcer {
   void completed(kj::StringPtr identity, uint64_t used) {
     if (dynamic) record("completed", identity, used);
   }
+  void progress(kj::StringPtr identity, uint64_t used) {
+    if (dynamic) writeLimitEvent(report("cpu-progress", identity, used));
+  }
   void culprit(kj::StringPtr identity, uint64_t used) {
     writeLimitEvent(report("culprit", identity, used));
   }
