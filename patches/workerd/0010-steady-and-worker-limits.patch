   auto line = kj::str("[coworkerd-platform] {\"isolate\":", escapeCpuJsonString(name),
       ",\"dynamic\":", dynamic ? "true" : "false", ",\"canCreateNewIsolateGroups\":",
@@ -213,7 +232,7 @@ class RequestLimits final: public LimitEnforcer {
