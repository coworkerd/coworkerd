From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: maslow <wangfugen@126.com>
Date: Wed, 25 Nov 2026 17:20:31 +0800
Subject: [PATCH] Take a drain branch from the mutable response promise


diff --git a/src/workerd/threaded/threaded-server.c++ b/src/workerd/threaded/threaded-server.c++
index 9285a8416195ed75757922a5670e4a19359665fc..fa62ed0c331e8f51b43bc2279df92a7af87edbeb 100644
--- a/src/workerd/threaded/threaded-server.c++
+++ b/src/workerd/threaded/threaded-server.c++
@@ -1792,8 +1792,12 @@ struct RequestLimits final: LimitEnforcer {
     auto deadline = [this]() {
       return timer.timer.atTime(kj::max(kj::systemPreciseMonotonicClock().now(), timer.timer.now()) + WAIT_UNTIL_LIMIT);
     };
-    auto wait = measurement.responseEnded.map([&](auto &ended) { return ended.addBranch().then(deadline); })
-        .orDefault([&]() { return deadline(); });
+    kj::Promise<void> wait = nullptr;
+    KJ_IF_SOME(ended, measurement.responseEnded) {
+      wait = ended.addBranch().then(deadline);
+    } else {
+      wait = deadline();
+    }
     KJ_IF_SOME(ended, measurement.requestLeaseEnded) {
       return kj::mv(wait).exclusiveJoin(ended.addBranch());
     }
