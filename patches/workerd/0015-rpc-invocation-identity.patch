From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Thu, 29 Oct 2026 06:33:09 +0000
Subject: [PATCH] Bind Coworkerd invocation identity to each dynamic entrypoint


diff --git a/src/workerd/api/worker-loader.c++ b/src/workerd/api/worker-loader.c++
index 78d0be261b3535dc05704234ae8f39dd220e3bf4..36eae6a935181d77179e3ba4fdee751a20be796b 100644
--- a/src/workerd/api/worker-loader.c++
+++ b/src/workerd/api/worker-loader.c++
@@ -28,11 +28,13 @@ jsg::Ref<Fetcher> WorkerStub::getEntrypoint(jsg::Lock& js,
     jsg::Optional<EntrypointOptions> options) {
   Frankenvalue props;
   kj::Maybe<ResourceLimits> limits;
+  kj::Maybe<kj::String> invocationIdentity;
   KJ_IF_SOME(o, options) {
     KJ_IF_SOME(p, o.props) {
       props = Frankenvalue::fromJs(js, p.getHandle(js));
     }
     limits = o.limits;
+    invocationIdentity = kj::mv(o.coworkerdInvocationIdentity);
   }
 
   kj::Maybe<kj::String> entrypointName;
@@ -44,7 +46,8 @@ jsg::Ref<Fetcher> WorkerStub::getEntrypoint(jsg::Lock& js,
     }
   }
 
-  auto subreqChannel = channel->getEntrypoint(kj::mv(entrypointName), kj::mv(props), limits);
+  auto subreqChannel = channel->getEntrypoint(
+      kj::mv(entrypointName), kj::mv(props), limits, kj::mv(invocationIdentity));
   return js.alloc<Fetcher>(IoContext::current().addObject(kj::mv(subreqChannel)));
 }
 
diff --git a/src/workerd/api/worker-loader.h b/src/workerd/api/worker-loader.h
index 94e738c9668b878db60326ab150b84520aceb1bc..3d63f70982f17df37b2e3f37859180da004c7ff0 100644
--- a/src/workerd/api/worker-loader.h
+++ b/src/workerd/api/worker-loader.h
@@ -22,8 +22,11 @@ class WorkerStub: public jsg::Object {
   struct EntrypointOptions {
     jsg::Optional<jsg::JsRef<jsg::JsObject>> props;
     jsg::Optional<ResourceLimits> limits;
+    // Coworkerd platform runtime only: its LOADER capability is never given to tenant code.
+    // An owned JSON identity of this entrypoint, independent of request cf and mutable props.
+    jsg::Optional<kj::String> coworkerdInvocationIdentity;
 
-    JSG_STRUCT(props, limits);
+    JSG_STRUCT(props, limits, coworkerdInvocationIdentity);
   };
 
   jsg::Ref<Fetcher> getEntrypoint(jsg::Lock& js,
diff --git a/src/workerd/io/io-channels.c++ b/src/workerd/io/io-channels.c++
index 1ccfccc2a5dabb63e710574786dfeb5cd4a2834d..91044886c90e5cb60e8679efb0d6e38189475199 100644
--- a/src/workerd/io/io-channels.c++
+++ b/src/workerd/io/io-channels.c++
@@ -274,15 +274,18 @@ kj::Rc<IoChannelFactory::RpcChannel> IoChannelFactory::makeRestoredRpcChannel(
 }
 
 kj::Rc<IoChannelFactory::SubrequestChannel> WorkerStubChannel::getEntrypoint(
-    kj::Maybe<kj::String> name, Frankenvalue props, kj::Maybe<ResourceLimits> limits) {
+    kj::Maybe<kj::String> name, Frankenvalue props, kj::Maybe<ResourceLimits> limits,
+    kj::Maybe<kj::String> invocationIdentity) {
   KJ_IF_SOME(promise, props.resolveCaps(resolveCap)) {
     return kj::rc<PromisedSubrequestChannel>(
         promise.then([self = addRefToThis(), name = kj::mv(name), props = kj::mv(props),
-                         limits = kj::mv(limits)]() mutable {
-      return self->getEntrypointResolved(kj::mv(name), kj::mv(props), kj::mv(limits));
+                         limits = kj::mv(limits), invocationIdentity = kj::mv(invocationIdentity)]() mutable {
+      return self->getEntrypointResolved(
+          kj::mv(name), kj::mv(props), kj::mv(limits), kj::mv(invocationIdentity));
     }));
   } else {
-    return getEntrypointResolved(kj::mv(name), kj::mv(props), kj::mv(limits));
+    return getEntrypointResolved(
+          kj::mv(name), kj::mv(props), kj::mv(limits), kj::mv(invocationIdentity));
   }
 }
 
diff --git a/src/workerd/io/io-channels.h b/src/workerd/io/io-channels.h
index 07b0295dc437f04d4fe2e252b294bddfa2db0a37..e726601c45ea7b0648e2eac0d9b24a5ea1d7d7ef 100644
--- a/src/workerd/io/io-channels.h
