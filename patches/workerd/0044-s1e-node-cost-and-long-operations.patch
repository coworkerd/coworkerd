++// JSON.stringify, the parser handles interrupts once per value, so that a
++// termination requested meanwhile (for example by a CPU or memory limit)
++// takes effect during the parse instead of after it. Returns true when an
++// interrupt left an exception (the termination) to propagate.
++V8_INLINE bool JsonParseInterrupted(Isolate* isolate) {
++  StackLimitCheck interrupt_check(isolate);
++  return V8_UNLIKELY(interrupt_check.InterruptRequested()) &&
++         IsExceptionHole(isolate->stack_guard()->HandleInterrupts());
