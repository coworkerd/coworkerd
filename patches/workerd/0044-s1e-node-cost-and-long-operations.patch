++// Parsing a large text allocates for as long as the text lasts. Like
++// JSON.stringify, the parser handles interrupts once per value, so that a
++// termination requested meanwhile (for example by a CPU or memory limit)
++// takes effect during the parse instead of after it. Returns true when an
++// interrupt left an exception (the termination) to propagate.
++V8_INLINE bool JsonParseInterrupted(Isolate* isolate) {
++  StackLimitCheck interrupt_check(isolate);
++  return V8_UNLIKELY(interrupt_check.InterruptRequested()) &&
++         IsExceptionHole(isolate->stack_guard()->HandleInterrupts());
++}
++
++// The largest array and object the parser builds. Beyond them the backing
++// stores cannot be allocated and V8 would end the process
++// ("Fatal JavaScript invalid size error", "invalid table size"), so the
++// parse throws a RangeError instead. An object's properties go into a
++// dictionary whose capacity rounds 1.5 times the count up to a power of two.
++constexpr size_t kMaxJsonArrayLength = FixedArray::kMaxLength;
++constexpr size_t kMaxJsonObjectProperties = NameDictionary::kMaxCapacity / 2;
++static_assert(kMaxJsonObjectProperties <= NumberDictionary::kMaxCapacity / 2);
++
+ }  // namespace
