++    // More characters than the largest array: the runtime throws a RangeError
++    // (AllocateFixedArray would end the process).
++    GotoIf(IntPtrGreaterThan(length, IntPtrConstant(FixedArray::kMaxLength)),
++           &call_runtime);
+ 
+     ToDirectStringAssembler to_direct(state(), subject_string);
+     to_direct.TryToDirect(&call_runtime);
