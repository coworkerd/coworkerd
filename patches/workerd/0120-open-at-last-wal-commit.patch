+void configureWal(SqliteDatabase& db, uint32_t& lastCommit) {
   db.run("PRAGMA page_size = 4096");
   db.run("CREATE TABLE entries (value BLOB)");
   KJ_REQUIRE(db.run("PRAGMA journal_mode = WAL").getText(0) == "wal"_kj);
