Subject: [PATCH] Reserve a distinct platform object execution identity


diff --git a/src/workerd/threaded/threaded-server-test.c++ b/src/workerd/threaded/threaded-server-test.c++
index ecef09c4462643c8fba4eb9b0732646b26a379a0..7aeb9d438bcc12e6f8c67386a2eb4ad0a2daf9ea 100644
--- a/src/workerd/threaded/threaded-server-test.c++
+++ b/src/workerd/threaded/threaded-server-test.c++
@@ -41,11 +41,11 @@ void customizeEntered(IsolateLimits& limits, v8::Isolate* isolate) {
 }
 
 KJ_TEST("platform durable plans pin the class and copy to the tenant") {
-  JsonDoc input(kj::str(R"({"workerId":"alpha/__platform","format":"v2","versionId":"build-a",
+  JsonDoc input(kj::str(R"({"workerId":"alpha/:platform","format":"v2","versionId":"build-a",
       "definitionHash":"definition","contentHash":"package","cpuLimitMs":200,"memoryLimitMiB":64})"));
-  JsonDoc otherTenant(kj::str(R"({"workerId":"beta/__platform","format":"v2","versionId":"build-a",
+  JsonDoc otherTenant(kj::str(R"({"workerId":"beta/:platform","format":"v2","versionId":"build-a",
       "definitionHash":"definition","contentHash":"package","cpuLimitMs":200,"memoryLimitMiB":64})"));
-  JsonDoc bound(kj::str(R"({"workerId":"alpha/__platform","format":"v2","versionId":"build-a",
+  JsonDoc bound(kj::str(R"({"workerId":"alpha/:platform","format":"v2","versionId":"build-a",
       "definitionHash":"definition","contentHash":"package","cpuLimitMs":200,"memoryLimitMiB":64,
       "variables":[{"name":"TENANT_SECRET","value":"fixture"}]})"));
   JsonDoc alpha(kj::str(R"({"tenant":"alpha","definitionName":"coworkerd:platform-test"})"));
diff --git a/src/workerd/threaded/threaded-server.c++ b/src/workerd/threaded/threaded-server.c++
index fa0700cf2f6f0c30d890c8c44b66c449d500886f..80b3af25846ee82b9ea3762f65c33a10f62b1c0f 100644
--- a/src/workerd/threaded/threaded-server.c++
+++ b/src/workerd/threaded/threaded-server.c++
@@ -2121,7 +2121,7 @@ std::string platformCopyKey(Json::Reader descriptor, Json::Reader plan) {
 bool platformDurablePlan(Json::Reader input, Json::Reader plan, Json::Reader selection,
     const DurableRoute &route) {
   const auto tenant = text(plan, "tenant");
-  if (tenant.size() == 0 || text(input, "workerId") != kj::str(tenant, "/__platform") ||
+  if (tenant.size() == 0 || text(input, "workerId") != kj::str(tenant, "/:platform") ||
       text(input, "format") != "v2" || text(selection, "className") != route.open.className.c_str() ||
       platformCopyKey(input, plan) != route.open.definition) return false;
   auto empty = [](Json::Reader value) {
