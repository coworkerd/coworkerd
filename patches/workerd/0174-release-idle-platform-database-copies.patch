From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: maslow <wangfugen@126.com>
Date: Thu, 26 Nov 2026 02:35:08 +0800
Subject: [PATCH] Release exclusive database copies when idle roots retire

Refs coworkerd/coworkerd#81

diff --git a/src/workerd/threaded/threaded-server-test.c++ b/src/workerd/threaded/threaded-server-test.c++
index 80f7c463fbbeff2864d8763428e5673a4ddf46f8..630e865d7467270ed53feda54c153ec7bd9a50ec 100644
--- a/src/workerd/threaded/threaded-server-test.c++
+++ b/src/workerd/threaded/threaded-server-test.c++
@@ -84,6 +84,16 @@ KJ_TEST("platform databases require a copy pinned to the specific object") {
   KJ_EXPECT(!platformDurablePlan(input.get(), plan.get(), selection.get(), route));
 }
 
+KJ_TEST("an exclusive database copy keeps its isolate while the home has a reservation") {
+  const auto database = PLATFORM_DATABASE_COPY_PREFIX + std::string(64, 'a');
+  const auto tenant = std::string(64, 'a') + ":" + std::string(64, 'b');
+  KJ_EXPECT(!shouldReleaseDurableCopy(1, false, database, false));
+  KJ_EXPECT(!shouldReleaseDurableCopy(0, true, database, false));
+  KJ_EXPECT(shouldReleaseDurableCopy(0, false, database, false));
+  KJ_EXPECT(!shouldReleaseDurableCopy(0, false, tenant, false));
+  KJ_EXPECT(shouldReleaseDurableCopy(0, false, tenant, true));
+}
+
 KJ_TEST("fatal record identifies only the invocation on the current V8 thread") {
   int fds[2];
   KJ_SYSCALL(pipe(fds));
diff --git a/src/workerd/threaded/threaded-server.c++ b/src/workerd/threaded/threaded-server.c++
index 4e15ba038621126344134a89d237cec03b8db71c..a4891131ed90379e6b79218c52ccfe090ae869be 100644
--- a/src/workerd/threaded/threaded-server.c++
+++ b/src/workerd/threaded/threaded-server.c++
@@ -2121,6 +2121,16 @@ bool productPlatformPlan(Json::Reader plan) {
       name.isString() && name.getString() == "coworkerd:platform";
 }
 
+constexpr char PLATFORM_DATABASE_COPY_PREFIX[] = "platform-object-v1:";
+
+bool shouldReleaseDurableCopy(uint32_t reservedTrees, bool hasResidentRoots,
+    const std::string &definition, bool resettingOrExpired) {
+  // The catalog mints tenant fingerprints with a hexadecimal definition hash first.
+  // The platform copy key below is recomputed when the database route is validated.
+  return reservedTrees == 0 && !hasResidentRoots &&
+      (resettingOrExpired || definition.starts_with(PLATFORM_DATABASE_COPY_PREFIX));
+}
+
 std::string platformCopyKey(Json::Reader descriptor, Json::Reader plan,
     const server::DurableAdmission::Key *object = nullptr) {
   auto namedLimit = [&](kj::StringPtr name) -> uint32_t {
@@ -2136,7 +2146,7 @@ std::string platformCopyKey(Json::Reader descriptor, Json::Reader plan,
       namedLimit("memoryLimitMiB"));
   if (object != nullptr) {
     auto exclusive = kj::str(identity, "\n", object->namespaceId.c_str(), "\n", object->objectId.c_str());
-    return "platform-object-v1:" + digest(exclusive.asBytes());
+    return PLATFORM_DATABASE_COPY_PREFIX + digest(exclusive.asBytes());
   }
   return "platform-v1:" + digest(identity.asBytes());
 }
@@ -3287,8 +3297,11 @@ struct ThreadedServer {
           home.memory >= memory.maximum - memory.maximum / 10 || rejectedGrowth, reclaimed);
       const auto idleMs = configuredCount("COWORKERD_THREADED_IDLE_EVICT_MS", 300000);
       const auto lastUse = state.durableSlot->lastUseNs.load();
-      releaseCopy = home.reservedTrees == 0 && state.durableRoots.empty() &&
-          (home.pressure.resetting() || (idleMs && nowNs() - lastUse >= idleMs * 1000000));
+      // An empty database copy still charges the process budget. Release it when its
+      // tree retires so a new database can open on an unused home.
+      releaseCopy = shouldReleaseDurableCopy(home.reservedTrees, !state.durableRoots.empty(),
+          state.durableSlot->planRevision,
+          home.pressure.resetting() || (idleMs && nowNs() - lastUse >= idleMs * 1000000));
     }
     if (pressureAction == server::DurablePressure::Action::RESET) {
       for (auto &[tree, root]: state.durableRoots) {
