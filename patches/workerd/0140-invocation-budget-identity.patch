 class RustIoChannelFactory final: public IoChannelFactory {
  public:
-  RustIoChannelFactory(kj::Own<CompiledWorker::Impl> worker, ::rust::Box<ChannelFactory> channels)
-      : worker(kj::mv(worker)),
