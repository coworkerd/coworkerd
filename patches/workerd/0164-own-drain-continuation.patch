From: maslow <wangfugen@126.com>
Date: Wed, 25 Nov 2026 18:41:52 +0800
Subject: [PATCH] Own the deferred response drain continuation


diff --git a/src/workerd/threaded/threaded-server.c++ b/src/workerd/threaded/threaded-server.c++
index 5ad1cb3023689f00adf1733d46c45750baab6700..f66a5927e6e97b409c8a16df6a0e4380f8d6feb6 100644
--- a/src/workerd/threaded/threaded-server.c++
+++ b/src/workerd/threaded/threaded-server.c++
@@ -1794,7 +1794,7 @@ struct RequestLimits final: LimitEnforcer {
     };
     kj::Promise<void> wait = nullptr;
     KJ_IF_SOME(ended, measurement.responseEnded) {
-      wait = ended.addBranch().then(deadline);
+      wait = ended.addBranch().then(kj::mv(deadline));
     } else {
       wait = deadline();
     }
