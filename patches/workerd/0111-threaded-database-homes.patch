+class NativeDatabaseHttp final: public kj::HttpService {
+ public:
+  NativeDatabaseHttp(ThreadedServer& server, ThreadState& state, DurableRoute route,
+      uint64_t tree, int connectionFd, kj::Maybe<uint64_t> alarm)
+      : server(server), state(state), route(std::move(route)), tree(tree),
+        connectionFd(connectionFd), alarm(alarm) {}
+
+  kj::Promise<void> request(kj::HttpMethod method, kj::StringPtr url, const kj::HttpHeaders&,
+      kj::AsyncInputStream& body, Response& response) override {
+    KJ_REQUIRE(!std::exchange(used, true), "one HTTP request per database event");
+    const auto resource = url.slice(url.findFirst('?').orDefault(url.size()));
+    const std::string_view path(url.begin(), url.size() - resource.size());
+    const bool query = path == "/query" || path.ends_with("://d1/query") ||
+        path.ends_with("://coworkerd-node/query");
+    const bool execute = path == "/execute" || path.ends_with("://d1/execute");
+    if (alarm == kj::none && (method != kj::HttpMethod::POST || (!query && !execute))) {
+      co_return co_await send(response, {404, "{\"error\":\"Not found\"}"});
+    }
+    auto input = co_await body.readAllText();
+    server::NativeSqlReply reply{0, {}};
+    try {
+      co_await open();
+    } catch (const kj::Exception& error) {
+      reply = storageFailure(error);
+    }
+    if (reply.status != 0) co_return co_await send(response, std::move(reply));
+    auto& database = *state.nativeDatabase;
+    auto& connection = *database.connection;
+    const auto started = nowNs();
+    bool reportAlarm = false;
+    try {
+      KJ_IF_SOME(time, alarm) {
+        const auto held = server::readDurableAlarm(connection);
+        const auto scheduled = kj::UNIX_EPOCH + static_cast<int64_t>(time) * kj::MILLISECONDS;
+        if (held == scheduled) {
+          connection.run("UPDATE _cf_METADATA SET value = NULL WHERE key = 1");
+          reportAlarm = true;
+          reply = {200, "{\"outcome\":\"cleared\"}"};
+        } else {
+          const auto heldMs = (held.orDefault(kj::UNIX_EPOCH) - kj::UNIX_EPOCH) / kj::MILLISECONDS;
+          reply = {200, "{\"outcome\":\"notDue\",\"atUnixMs\":" + std::to_string(heldMs) + "}"};
+        }
+      } else {
+        const auto format = resource == "?resultsFormat=ROWS_AND_COLUMNS"
+            ? server::NativeSqlResults::COLUMNS : server::NativeSqlResults::OBJECTS;
+        reply = server::runNativeSql(connection, input, query, format,
+            server::DurableAdmission::Clock::now() + server::NATIVE_SQL_LIMIT, connectionFd);
+      }
+    } catch (const kj::Exception& error) {
+      reply = storageFailure(error);
+    }
+    const auto finished = nowNs();
+    // A canceled client must not cancel acknowledgement of already committed WAL.
+    // Keep the admitted connection alive until the outstanding confirmation settles.
+    if (connection.observedCriticalError() || reply.status == 0 || reply.status == 503) {
+      server.closeNativeDatabase(state);
+    }
+    database.confirming = true;
+    auto confirmation = confirm(database, reportAlarm).fork();
+    state.tasks.add(confirmation.addBranch().catch_([](kj::Exception&&) {}));
+    try {
+      co_await confirmation.addBranch();
+    } catch (const kj::Exception& error) {
+      reply = storageFailure(error);
+    }
+    if (finished - started >= 1000000000) {
+      fprintf(stderr, "[native-sql] {\"pid\":%d,\"generation\":%llu,\"home\":%llu,"
+          "\"namespaceId\":\"%.12s\",\"startedMonotonicNs\":%llu,"
+          "\"finishedMonotonicNs\":%llu,\"confirmedMonotonicNs\":%llu,\"status\":%u}\n",
+          getpid(), static_cast<unsigned long long>(route.open.generation),
+          static_cast<unsigned long long>(state.durableHome), route.key.namespaceId.c_str(),
+          static_cast<unsigned long long>(started), static_cast<unsigned long long>(finished),
+          static_cast<unsigned long long>(nowNs()), reply.status);
+    }
+    if (reply.status != 0) co_await send(response, std::move(reply));
+  }
+
+ private:
+  ThreadedServer& server;
+  ThreadState& state;
+  DurableRoute route;
+  uint64_t tree;
+  int connectionFd;
+  kj::Maybe<uint64_t> alarm;
+  bool used = false;
+
+  static server::NativeSqlReply storageFailure(const kj::Exception& error) {
+    auto reason = error.getDescription();
+    if (reason.startsWith("jsg.Error: ")) reason = reason.slice(sizeof("jsg.Error: ") - 1);
+    auto code = "STORAGE_UNAVAILABLE"_kj;
+    uint status = 503;
+    if (reason.endsWith("(DO_OBJECT_TOO_LARGE)")) {
+      code = "DO_OBJECT_TOO_LARGE"_kj;
+      status = 413;
+    } else if (reason.endsWith("(QUOTA_EXCEEDED)")) {
+      code = "QUOTA_EXCEEDED"_kj;
+      status = 422;
+    } else {
+      reason = "Durable Object storage is unavailable"_kj;
+    }
+    return {status, server::nativeSqlFailure(code, reason)};
+  }
+
+  kj::Promise<void> send(Response& response, server::NativeSqlReply reply) {
+    kj::HttpHeaders headers(*state.headers);
+    headers.setPtr(kj::HttpHeaderId::CONTENT_TYPE, "application/json");
+    auto reason = reply.status == 200 ? "OK" : reply.status == 400 ? "Bad Request"
+        : reply.status == 404 ? "Not Found" : reply.status == 413 ? "Payload Too Large"
+        : reply.status == 422 ? "Unprocessable Entity" : "Service Unavailable";
+    auto output = response.send(reply.status, reason, headers, reply.body.size());
+    co_await output->write(kj::arrayPtr(reinterpret_cast<const kj::byte*>(reply.body.data()),
+        reply.body.size()));
+  }
+
+  kj::Promise<void> open() {
+    if (!state.nativeDatabase) {
+      server::DurableWalPosition position;
+      if (state.wal) position = co_await prepareRootWal(server, state, route, tree);
+      // A database can claim a spare home that still holds an empty warm copy.
+      // Release the copy on its own loop before opening SQLite.
+      state.durableSlot.reset();
+      {
+        std::lock_guard lock(server.durableRoutingMutex);
+        auto& home = *server.threads[state.durableHome - 1]->home;
+        home.warmDefinition.clear();
+        home.memory = 0;
+      }
+      const auto openStarted = nowNs();
+      auto connection = server.durableStorage->open(route.uniqueKey.c_str(), route.storageId.c_str());
+      kj::Own<server::DurableLogShipper> shipper;
+      if (state.wal) {
+        shipper = server.durableStorage->ship(route.uniqueKey.c_str(),
+            {.objectName = kj::str(route.key.namespaceId.c_str(), "/", route.key.objectId.c_str(),
+                "/", route.open.dataEpoch), .storageId = kj::str(route.storageId.c_str())},
+            *connection, state.io.provider->getTimer(), *state.wal, position, openStarted);
+        shipper->reportAlarm(server::readDurableAlarm(*connection));
+      }
+      state.nativeDatabase.emplace(ThreadState::NativeDatabase{
+        tree, server::DurableAdmission::Clock::now(), kj::mv(connection), kj::mv(shipper)
+      });
+      server.publishDurableRoot(state.durableHome, tree);
+    }
+    auto& database = *state.nativeDatabase;
+    KJ_REQUIRE(database.tree == tree, "mismatched native database home");
+    try {
+      if (state.wal) {
+        co_await state.wal->waitForOpen(database.shipper->getOpenId(), state.io.provider->getTimer());
+      }
+      KJ_REQUIRE(!database.closing, "the database image is closing");
+    } catch (const kj::Exception&) {
+      server.closeNativeDatabase(state);
+      throw;
+    }
+  }
+
+  kj::Promise<void> confirm(ThreadState::NativeDatabase& database, bool reportAlarm) {
+    auto& owner = server;
+    auto& home = state;
+    auto& timer = state.io.provider->getTimer();
+    KJ_DEFER({
+      database.confirming = false;
+      std::lock_guard lock(owner.durableRoutingMutex);
+      owner.wakeDurableTree(database.tree);
+    });
+    if (!database.shipper && owner.durableCommitDelayMs == 0) co_return;
+    owner.durablePendingCommits.fetch_add(1);
+    KJ_DEFER(owner.durablePendingCommits.fetch_sub(1));
+    try {
+      if (database.shipper) {
+        co_await database.shipper->onCommit();
+        if (reportAlarm) database.shipper->reportAlarm(kj::none);
+      } else {
+        co_await timer.afterDelay(owner.durableCommitDelayMs * kj::MILLISECONDS);
+      }
+    } catch (const kj::Exception&) {
+      owner.closeNativeDatabase(home);
+      throw;
+    }
+  }
+};
+
+class NativeDatabaseDispatcher final: public rpc::EventDispatcher::Server {
+ public:
+  NativeDatabaseDispatcher(ThreadState& state, kj::Own<kj::HttpService> service)
+      : state(state), service(kj::mv(service)) {}
+
+  kj::Promise<void> getHttpService(GetHttpServiceContext context) override {
+    KJ_REQUIRE(service.get() != nullptr, "one event per database invocation");
+    context.getResults().setHttp(state.http.kjToCapnp(kj::mv(service)));
+    return kj::READY_NOW;
+  }
+
+ private:
+  ThreadState& state;
+  kj::Own<kj::HttpService> service;
+};
