+IsolateGc::IsolateGc(kj::StringPtr name, bool dynamic, uint64_t cpuLimitNs)
+    : name(kj::str(name)), dynamic(dynamic), cpuLimitNs(cpuLimitNs) {
+  if (dynamic && cpuLimitNs && gcSettings().excludes()) budget = budgetFor(name);
+}
+IsolateGc::~IsolateGc() noexcept(false) {}
+
+void IsolateGc::install(v8::Isolate* value) {
+  isolate = value;
+  clock = kj::heap<ThreadCpuClock>();
+  value->AddGCPrologueCallback(&IsolateGc::prologue, this, v8::kGCTypeAll);
+  value->AddGCEpilogueCallback(&IsolateGc::epilogue, this, v8::kGCTypeAll);
+  if (dynamic && gcSettings().idleCollectMs) oldUsed = oldAfterMajor = oldGenerationBytes();
+}
+
+void IsolateGc::prologue(v8::Isolate*, v8::GCType type, v8::GCCallbackFlags, void* data) {
+  static_cast<IsolateGc*>(data)->began(type);
+}
+void IsolateGc::epilogue(v8::Isolate*, v8::GCType type, v8::GCCallbackFlags, void* data) {
+  static_cast<IsolateGc*>(data)->ended(type);
+}
+
+void IsolateGc::began(v8::GCType value) {
+  // A collection inside another one (the weak callbacks of a mark-compact) is part of it.
+  if (depth++ > 0) return;
+  type = value;
+  startCpu = KJ_ASSERT_NONNULL(clock)->now();
+  startMono = monotonicNs();
+  startedInside = inside;
+  startedExcludable = false;
+  if (startedInside && budget && (type & EXCLUDABLE)) {
+    excludableBudgetNs.store(budget->refill(startMono), std::memory_order_release);
+    excludableStartCpu.store(startCpu ? startCpu : 1, std::memory_order_release);
+    startedExcludable = true;
+  }
+}
+
+void IsolateGc::ended(v8::GCType) {
+  if (depth == 0 || --depth > 0) return;
+  auto cpuNow = KJ_ASSERT_NONNULL(clock)->now();
+  const uint64_t cpu = cpuNow > startCpu ? cpuNow - startCpu : 0;
+  const uint64_t pause = monotonicNs() - startMono;
+  uint64_t excluded = 0, left = 0;
+  if (startedExcludable) {
+    excluded = budget->spend(cpu);
+    left = budget->refill(startMono);
+    excludedNs.fetch_add(excluded, std::memory_order_acq_rel);
+    excludableStartCpu.store(0, std::memory_order_release);
+  }
+  const bool major = (type & MAJOR) != 0;
+  if (major) ++majors;
+  const auto& settings = gcSettings();
+  if (dynamic && settings.idleCollectMs) {
+    oldUsed = oldGenerationBytes();
+    if (major) oldAfterMajor = oldUsed;
+  }
+  uint64_t live = 0, limit = 0;
+  if (!dynamic && major) {
+    v8::HeapStatistics stats;
+    isolate->GetHeapStatistics(&stats);
+    live = stats.used_heap_size();
+    limit = stats.heap_size_limit();
+    if (auto* cpp = isolate->GetCppHeap()) {
+      live += cpp->CollectStatistics(cppgc::HeapStatistics::DetailLevel::kBrief).used_size_bytes;
+    }
+  }
+  const bool longPause = settings.longPauseNs && pause >= settings.longPauseNs;
+  {
+    auto lock = processGc().lockExclusive();
+    auto& p = *lock;
+    ++p.version;
+    if (major) ++p.majors;
+    else if (type & v8::kGCTypeProcessWeakCallbacks) ++p.weakCallbacks;
+    else ++p.minors;
+    p.excludedNs += excluded;
+    if (startedInside && (type & EXCLUDABLE)) p.chargedMajorNs += cpu - excluded;
+    if (longPause) ++p.longPauses;
+    if (pause > p.longestPauseNs) {
+      p.longestPauseNs = pause;
+      p.longestPauseIsolate = name.cStr();
+      p.longestPauseType = typeName(type);
+    }
+    if (major && majors == 1 && pause > p.firstMajorLongestNs) {
+      p.firstMajorLongestNs = pause;
+      p.firstMajorLongestIsolate = name.cStr();
+    }
+    if (!dynamic && major) {
+      auto& heap = p.statics[name.cStr()];
+      ++heap.majors;
+      heap.liveAfterMajorBytes = live;
+      heap.peakLiveAfterMajorBytes = std::max(heap.peakLiveAfterMajorBytes, live);
+      heap.heapLimitBytes = limit;
+    }
+  }
+  if (longPause) {
+    writeRow(kj::str("{\"event\":\"gc-pause\",\"isolate\":", escapeCpuJsonString(name), ',',
+        startedInside ? identity : kj::StringPtr(""), "\"cpuUsedNs\":", cpu, ",\"cpuLimitMs\":", cpuLimitNs / 1000000,
+        ",\"pid\":", coworkerdPid(), ",\"gcType\":\"", typeName(type), "\",\"pauseNs\":", pause,
+        ",\"gcExcludedNs\":", excluded, ",\"gcBudgetNs\":", left, ",\"inRequest\":", startedInside ? "true" : "false",
+        ",\"idleCollection\":", idle ? "true" : "false", ",\"majorOrdinal\":", major ? majors : 0,
+        ",\"observedAtUnixMs\":", unixMs(), "}\n"));
+  }
+}
+
+// The old generation of the unified heap: V8's spaces but the young ones, and cppgc's objects (the jsg wrappers' C++
+// side, which a full collection of the V8 heap collects too and whose growth alone can trigger one).
+size_t IsolateGc::oldGenerationBytes() const {
+  size_t total = 0;
+  auto spaces = isolate->NumberOfHeapSpaces();
+  for (size_t i = 0; i < spaces; ++i) {
+    v8::HeapSpaceStatistics space;
+    if (!isolate->GetHeapSpaceStatistics(&space, i)) continue;
+    kj::StringPtr spaceName = space.space_name();
+    if (spaceName == "new_space" || spaceName == "new_large_object_space") continue;
+    total += space.space_used_size();
+  }
+  if (auto* cpp = isolate->GetCppHeap()) {
+    total += cpp->CollectStatistics(cppgc::HeapStatistics::DetailLevel::kBrief).used_size_bytes;
+  }
+  return total;
+}
+
+void IsolateGc::measureOld() {
+  // At most every few milliseconds: a request's entries come in bursts, and the collections measure it anyway.
+  if (!dynamic || !isolate || !gcSettings().idleCollectMs) return;
+  auto now = monotonicNs();
+  if (now - lastMeasured < 5000000) return;
+  lastMeasured = now;
+  oldUsed = oldGenerationBytes();
+}
+
+void IsolateGc::collectIdle(v8::Isolate* value) {
+  idle = true;
+  KJ_DEFER(idle = false);
+  value->MemoryPressureNotification(v8::MemoryPressureLevel::kCritical);
+}
+
+IsolateGc::Entry::Entry(IsolateGc* gc, kj::StringPtr identity): gc(gc) {
+  if (!gc) return;
+  base = gc->excludedNs.load(std::memory_order_acquire);
+  previousIdentity = gc->identity;
+  previousInside = gc->inside;
+  gc->identity = identity;
+  gc->inside = true;
+}
+IsolateGc::Entry::~Entry() noexcept(false) {
+  if (!gc) return;
+  gc->identity = previousIdentity;
+  gc->inside = previousInside;
+}
+uint64_t IsolateGc::Entry::excluded(uint64_t entryStartCpu, uint64_t cpuNow) const {
+  if (!gc || !gc->budget) return 0;
+  auto inGc = gc->excludableStartCpu.load(std::memory_order_acquire);
+  auto inGcBudget = gc->excludableBudgetNs.load(std::memory_order_acquire);
+  uint64_t total = gc->excludedNs.load(std::memory_order_acquire) - base;
+  if (inGc && cpuNow > inGc) total += std::min(cpuNow - inGc, inGcBudget);
+  return std::min(total, cpuNow > entryStartCpu ? cpuNow - entryStartCpu : uint64_t(0));
+}
+
+}  // namespace workerd::server
diff --git a/src/workerd/server/factory/coworkerd-gc.h b/src/workerd/server/factory/coworkerd-gc.h
new file mode 100644
index 0000000000000000000000000000000000000000..d6cd2afb63cd3080fde1ae67dff33b674d67cd0c
--- /dev/null
+++ b/src/workerd/server/factory/coworkerd-gc.h
@@ -0,0 +1,155 @@
+#pragma once
+// Coworkerd: V8's garbage collection under the CPU limit. A major GC -- one atomic mark-compact of the V8 heap and
+// cppgc together, most of it the destruction of dead jsg wrappers -- runs inside the request whose allocation
+// triggered it, and the CPU limit used to charge all of it to that request: the request was terminated, and its
+// isolate with it, although its own JavaScript had used a few milliseconds. Here, each part enabled by the
+// environment the node gives workerd (read once per process; without it nothing changes):
+//
+//   COWORKERD_GC_BUDGET_MS, COWORKERD_GC_REFILL_MS_PER_S
+//       The thread CPU of a major GC that runs inside a JS entry is not charged to the entry, up to a token bucket
+//       per Worker of that many milliseconds, refilled at that rate of wall time; beyond it the GC is charged as
+//       before. The bucket is the Worker's (the isolate name before its version), not the isolate's, so an isolate
+//       the limit revoked does not come back with a full one. 0: every GC is charged (as before).
+//   COWORKERD_GC_LONG_PAUSE_MS
+//       A collection whose pause reaches this writes one row, event gc-pause, where the CPU limit writes its rows
+//       (the log's [cpu-limit] lines and the limit event pipe): which isolate, how long, in whose request, what kind.
+//   COWORKERD_IDLE_GC_MS, COWORKERD_IDLE_GC_MIN_MIB
+//       The idle reaper collects a dynamic isolate between requests once it has been idle that long and its old
+//       generation grew that much since its last mark-compact (coworkerd-idle-eviction.c++).
+//   COWORKERD_STATIC_HEAP_MIB
+//       The heap constraint of the static isolates (the runtime), which V8 otherwise sizes from the machine.
+#include <kj/async.h>
+#include <kj/function.h>
+#include <kj/string.h>
+#include <v8-callbacks.h>
+#include <v8-isolate.h>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <pthread.h>
+#include <time.h>
+#if __APPLE__
+#include <mach/mach.h>
+#endif
+
+namespace workerd {
+class Worker;
+}
+
+namespace workerd::server {
+
+struct GcSettings {
+  uint64_t budgetNs = 0, refillNsPerSecond = 0;
+  uint64_t longPauseNs = 0;
+  uint32_t idleCollectMs = 0;
+  uint64_t idleCollectMinBytes = 4ull << 20;
+  uint64_t staticHeapBytes = 0;
+  bool excludes() const { return budgetNs != 0; }
+  // Whether the isolates need the GC callbacks at all.
+  bool observes() const { return excludes() || longPauseNs != 0 || idleCollectMs != 0; }
+};
+const GcSettings& gcSettings();
+void recordStaticHeapLimit(v8::Isolate* isolate, kj::StringPtr name);
+
+// A thread's CPU time, created on that thread and readable from any other (the limit watchdog reads the isolate
+// thread's).
+struct ThreadCpuClock {
+#if __APPLE__
+  mach_port_t thread = mach_thread_self();
+  ThreadCpuClock() = default;
+  ThreadCpuClock(const ThreadCpuClock&) = delete;
+  ~ThreadCpuClock() { mach_port_deallocate(mach_task_self(), thread); }
+  uint64_t now() const;
+#else
+  clockid_t clock;
+  ThreadCpuClock();
+  ThreadCpuClock(const ThreadCpuClock&) = delete;
+  uint64_t now() const;
+#endif
+};
+
+// A Worker's GC budget in this process (coworkerd-gc.c++).
+class GcBudget;
+
+// What one idle collection came to (coworkerd-idle-eviction.c++ counts them).
+enum class IdleCollection { COLLECTED, BUSY, GONE };
+
+// One isolate's collections: its GC callbacks, its CPU limit's entries and the idle reaper on the isolate's thread,
+// and the limit watchdog on its own thread (the atomics). Owned by the isolate's limit enforcer, which outlives the
+// V8 isolate (Worker::Isolate destroys its API, and with it the V8 isolate, before its limit enforcer), so the
+// callbacks are never removed: they end with the isolate.
+class IsolateGc {
+ public:
+  IsolateGc(kj::StringPtr name, bool dynamic, uint64_t cpuLimitNs);
+  ~IsolateGc() noexcept(false);
+  IsolateGc(const IsolateGc&) = delete;
+
+  // On the isolate's thread, once, before any JavaScript: the callbacks, and the clock the exclusion reads.
+  void install(v8::Isolate* isolate);
+
+  // A JS entry of this isolate (the CPU limit's scope) for as long as it runs: the collections that happen meanwhile
+  // run inside it, in the request `identity` names (the CPU limit's identity fragment; empty outside a request).
+  class Entry {
+   public:
+    Entry(IsolateGc* gc, kj::StringPtr identity);
+    ~Entry() noexcept(false);
+    Entry(const Entry&) = delete;
+    // The excluded GC CPU since this entry began: collections finished meanwhile and the one in progress (at most what
+    // its Worker's budget held when it began), never more than the entry's own CPU. Read on the watchdog thread with
+    // its registry locked, and on the isolate's thread when the entry ends. The in-progress start is read before the
+    // total, so a collection that ends in between may be counted twice (a late termination), never missed (an early one).
+    uint64_t excluded(uint64_t entryStartCpu, uint64_t cpuNow) const;
+
+   private:
+    IsolateGc* gc;
+    uint64_t base = 0;
+    kj::StringPtr previousIdentity;
+    bool previousInside = false;
+  };
+
+  // The idle reaper's view: whether the old generation grew enough since the last mark-compact to be worth a
+  // collection, and by how much.
+  uint64_t oldGrowth() const { return oldUsed > oldAfterMajor ? oldUsed - oldAfterMajor : 0; }
+  uint64_t majorCollections() const { return majors; }
+  // A full collection of this isolate between requests (fix B): with the isolate locked on its own thread, V8 collects
+  // synchronously -- a full GC that reduces the footprint, then another while that keeps freeing much.
+  void collectIdle(v8::Isolate* isolate);
+  // The isolate's old generation, measured again (at the end of a JS entry: what an allocation in old space added).
+  void measureOld();
+
+  kj::StringPtr getName() const { return name; }
+  bool isDynamic() const { return dynamic; }
+
+ private:
+  static void prologue(v8::Isolate* isolate, v8::GCType type, v8::GCCallbackFlags flags, void* data);
+  static void epilogue(v8::Isolate* isolate, v8::GCType type, v8::GCCallbackFlags flags, void* data);
+  void began(v8::GCType type);
+  void ended(v8::GCType type);
+  size_t oldGenerationBytes() const;
+
+  const kj::String name;
+  const bool dynamic;
+  const uint64_t cpuLimitNs;
+  std::shared_ptr<GcBudget> budget;  // dynamic isolates while the exclusion is on
+  v8::Isolate* isolate = nullptr;
+  kj::Maybe<kj::Own<ThreadCpuClock>> clock;
+
+  // The isolate's thread only.
+  uint32_t depth = 0;
+  v8::GCType type = v8::kGCTypeScavenge;
+  uint64_t startCpu = 0, startMono = 0;
+  bool startedInside = false, startedExcludable = false, idle = false;
+  bool inside = false;
+  kj::StringPtr identity;
+  uint64_t majors = 0;
+  // The old generation of the unified heap (V8's old spaces and cppgc's objects): at the last measurement, and right
+  // after the last full collection.
+  uint64_t oldUsed = 0, oldAfterMajor = 0, lastMeasured = 0;
+
+  // Shared with the limit watchdog.
+  std::atomic<uint64_t> excludableStartCpu{0};  // nonzero while an excludable collection runs: its start
+  std::atomic<uint64_t> excludableBudgetNs{0};  // what its Worker's budget held when it began
+  std::atomic<uint64_t> excludedNs{0};          // excluded GC CPU since this isolate began
+};
+
+}  // namespace workerd::server
